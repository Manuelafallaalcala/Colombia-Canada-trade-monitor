   "source": [
    "# Aplicar el costo logistico por ruta a los 10 productos\n",
    "#\n",
    "# El archivo de fletes no distingue por producto (no tiene codigo_hs), asi que el\n",
    "# mismo costo COP/kg por ruta se aplica a las 10 filas de 'productos'. Es una\n",
    "# simplificacion real del modelo, no un detalle menor: en la practica, flores\n",
    "# frescas o medicamentos que necesitan cadena de frio costarian mas transportar que\n",
    "# carga seca (cafe, carbon), porque requieren contenedor refrigerado (reefer), que\n",
    "# el archivo fuente no cotiza. Queda documentado como limitacion en vez de inventar\n",
    "# un diferencial por producto sin datos que lo respalden.\n",
    "\n",
    "productos['costo_logistico_mtl'] = costo_logistico_cop_kg['CTG-Montreal']\n",
    "productos['costo_logistico_yvr'] = costo_logistico_cop_kg['CTG-Vancouver']\n",
    "\n",
    "print(f'Filas en productos: {len(productos)} (esperado 10)')\n",
    "productos[['producto', 'codigo_hs', 'precio_cad', 'costo_logistico_mtl', 'costo_logistico_yvr']]"
   ]
  },
