   "source": [
    "# Sub-paso 1 (Seccion 7.12.2 de la guia): cargar el archivo de Drawback / Plan Vallejo\n",
    "# (Tarea 3, Bloque A). Ver nota de integridad de datos en la celda markdown de arriba: el\n",
    "# archivo se recargo con el encabezado reconstruido, sin alterar ningun valor de celda.\n",
    "\n",
    "ruta_drawback = '../dataraw/tabla_B3_drawback_iva.xlsx'\n",
    "drawback = pd.read_excel(ruta_drawback)\n",
    "\n",
    "columnas_esperadas = {'numero', 'producto', 'codigo_hs', 'drawback_aplica', 'tipo_beneficio', 'fuente', 'fecha_consulta'}\n",
    "columnas_faltantes = columnas_esperadas - set(drawback.columns)\n",
    "assert not columnas_faltantes, f'Faltan columnas esperadas en tabla_B3: {columnas_faltantes}'\n",
    "\n",
    "print(f'Registros cargados: {len(drawback)} (esperado 10)')\n",
    "print('\\nDistribucion de drawback_aplica (columna original, Tarea 3):')\n",
    "print(drawback['drawback_aplica'].value_counts())\n",
    "drawback[['numero', 'producto', 'codigo_hs', 'drawback_aplica']]\n"
   ]
  },
