   "source": [
    "# Retornos diarios de COP/CAD usando el logaritmo natural (convencion estandar en finanzas)\n",
    "# retorno_log_t = ln(COP_CAD_t / COP_CAD_t-1)\n",
    "cop_cad_df['retorno_log'] = np.log(cop_cad_df['COP_CAD'] / cop_cad_df['COP_CAD'].shift(1))\n",
    "\n",
    "# La primera fila queda en NaN porque no hay dato previo con el cual comparar\n",
    "print(f'Retornos calculados: {cop_cad_df[\"retorno_log\"].notna().sum()} de {len(cop_cad_df)} filas')\n",
    "cop_cad_df[['fecha', 'COP_CAD', 'retorno_log']].head(10)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6c704902",
   "metadata": {},
   "source": [
    " Volatilidad diaria, anualización y verificaciones de calidad:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "15d8c29b",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-24T01:17:34.578743Z",
     "iopub.status.busy": "2026-07-24T01:17:34.578493Z",
     "iopub.status.idle": "2026-07-24T01:17:34.587864Z",
