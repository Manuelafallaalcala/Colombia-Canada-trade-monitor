   "source": [
    "# ============================================================\n",
    "# Figura 7: Margenes bajo episodios historicos de estres (Seccion 8.4 de la guia)\n",
    "# ============================================================\n",
    "# Se usa tabla_stress (Etapa 9, 80 filas: 4 episodios x 10 productos x 2 rutas), promediando\n",
    "# entre las 2 rutas por producto+episodio, como pide la guia.\n",
    "#\n",
    "# Enriquecimiento sobre el codigo base de la guia: los episodios se ordenan de mas adverso a\n",
    "# mas favorable (por COPCAD_implicado ascendente, Etapa 9) en vez de dejar el orden por defecto\n",
    "# de pivot_table -asi la leyenda misma ya comunica una jerarquia de severidad, consistente con\n",
    "# el hallazgo de la Etapa 9 de que la Apreciacion del peso (no la Devaluacion) es el episodio\n",
    "# realmente adverso para el margen del exportador en este modelo.\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(14, 7))\n",
    "\n",
    "pivote_stress = tabla_stress.pivot_table(index='producto', columns='episodio', values='margen_pct', aggfunc='mean')\n",
    "orden_episodios = episodios.sort_values('COPCAD_implicado')['nombre_episodio'].tolist()\n",
    "pivote_stress = pivote_stress[orden_episodios]\n",
    "\n",
    "pivote_stress.plot(kind='bar', ax=ax)\n",
    "ax.axhline(y=0, color='black', linestyle='--', linewidth=1)\n",
    "ax.set_ylabel('Margen (%)')\n",
    "ax.set_xlabel('')\n",
    "ax.set_title('Margenes bajo episodios historicos de estres cambiario', fontweight='bold')\n",
    "ax.tick_params(axis='x', rotation=75)\n",
    "ax.legend(title='Episodio (de mas adverso a mas favorable)', bbox_to_anchor=(1.02, 1), loc='upper left')\n",
    "\n",
    "plt.tight_layout()\n",
    "ruta_figura07 = '../outputs/figures/figura_07_stress_testing.png'\n",
    "plt.savefig(ruta_figura07, dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(f'Figura guardada en: {ruta_figura07}')\n",
    "print('\\nNota de lectura: el margen de Carbon bituminoso en el episodio de Apreciacion (~-413%,')\n",
    "print('promedio entre rutas) esta muy por fuera de la escala razonable de los otros 9 productos.')\n",
    "print('Se mantiene sin recortar el eje -ocultar el valor real distorsionaria la magnitud del')\n",
    "print('riesgo ya documentado desde la Etapa 6/9-, aunque esto comprime visualmente las')\n",
    "print('diferencias entre el resto de productos, que se pueden leer con precision en tabla_stress.')\n"
   ]
