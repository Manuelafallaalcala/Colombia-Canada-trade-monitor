   "source": [
    "# Sub-paso 1 (Seccion 7.8.2 de la guia): cargar la estructura de costos por producto.\n",
    "#\n",
    "# Se carga tal cual quedo guardada en la Tarea 9 del Bloque A (dataraw/, sesion anterior). A\n",
    "# diferencia de tabla_B4 (Etapa 6), este archivo no tiene ningun problema de codificacion en\n",
    "# los encabezados porque se genero directamente con pandas en este mismo proyecto -aun asi,\n",
    "# se verifica que las columnas esperadas existan en vez de asumirlo a ciegas, para que la\n",
    "# celda falle de forma clara y temprana si el archivo cambia de forma en el futuro.\n",
    "\n",
    "ruta_costos = '../dataraw/tabla_B9_estructura_costos.xlsx'\n",
    "costos = pd.read_excel(ruta_costos)\n",
    "\n",
    "columnas_esperadas = {'producto', 'codigo_hs', 'pct_importado', 'pct_nacional'}\n",
    "columnas_faltantes = columnas_esperadas - set(costos.columns)\n",
    "assert not columnas_faltantes, f'Faltan columnas esperadas en tabla_B9: {columnas_faltantes}'\n",
    "\n",
    "print(f'Registros cargados: {len(costos)} (esperado 10)')\n",
    "costos[['numero', 'producto', 'codigo_hs', 'pct_importado', 'pct_nacional']]"
   ]
