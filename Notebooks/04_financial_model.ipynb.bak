   "source": [
    "# Sub-paso 3 (Seccion 7.10.2): tomar el IBR mas reciente disponible y convertirlo a formato\n",
    "# decimal diario. Se usa .dropna().iloc[-1] (no un indice fijo) para que la celda siga\n",
    "# funcionando correctamente si en el futuro se agregan mas meses al archivo -el \"mas\n",
    "# reciente\" siempre se toma de forma dinamica, nunca se asume una fila especifica.\n",
    "\n",
    "ibr_mas_reciente = tasas['ibr_colombia_pct'].dropna().iloc[-1]\n",
    "fecha_ibr_reciente = tasas.loc[tasas['ibr_colombia_pct'].notna(), 'fecha'].iloc[-1]\n",
    "\n",
    "ibr_anual = ibr_mas_reciente / 100\n",
    "ibr_diaria = ibr_anual / 365  # convencion actual/365, la misma del ejemplo numerico de la Seccion 3.9 de la guia\n",
    "\n",
    "print(f'IBR mas reciente usado: {ibr_mas_reciente:.3f}% (mes: {fecha_ibr_reciente})')\n",
    "print(f'IBR anual (decimal): {ibr_anual:.5f}')\n",
    "print(f'IBR diario (decimal, base actual/365): {ibr_diaria:.7f}')\n",
    "\n",
    "# Verificacion: el numero usado debe coincidir con la ultima fila NO NULA de la serie.\n",
    "assert np.isclose(ibr_mas_reciente, tasas['ibr_colombia_pct'].dropna().iloc[-1])\n",
    "\n",
    "# Rango historico completo de la serie (se usa mas abajo para la sensibilidad a la tasa de\n",
    "# interes).\n",
    "ibr_historico_min = tasas['ibr_colombia_pct'].min()\n",
    "ibr_historico_max = tasas['ibr_colombia_pct'].max()\n",
    "print(f'\\nRango historico completo del IBR (ene-2020 a {tasas[\"fecha\"].iloc[-1]}): '\n",
    "      f'{ibr_historico_min:.2f}% a {ibr_historico_max:.2f}%')"
   ]
  },
