   "source": [
    "# Sub-paso 8, 9 y 10 (Seccion 7.8.3): aplicar la formula de cobertura natural.\n",
    "#\n",
    "# costo_importado_base y costo_nacional se calculan sobre costo_produccion_cop, que en la\n",
    "# Etapa 6 se fijo UNA SOLA VEZ con el tipo de cambio base (no cambia entre escenarios: sigue\n",
    "# siendo la misma logica de \"costo fijo, ingreso variable\" de la Etapa 6, solo que ahora se\n",
    "# reconoce que una parte de ese costo fijo en realidad si se mueve con el tipo de cambio).\n",
    "#\n",
    "# costo_logistico se recupera algebraicamente de la propia tabla_margenes de la Etapa 6\n",
    "# (costo_total_cop - costo_produccion_cop) en vez de volver a calcularlo por separado, para\n",
    "# garantizar que sea exactamente el mismo numero que ya se uso y verifico en esa etapa.\n",
    "\n",
    "tabla_cob['costo_importado_base'] = tabla_cob['costo_produccion_cop'] * tabla_cob['pct_importado']\n",
    "tabla_cob['costo_nacional'] = tabla_cob['costo_produccion_cop'] * tabla_cob['pct_nacional']\n",
    "tabla_cob['costo_logistico'] = tabla_cob['costo_total_cop'] - tabla_cob['costo_produccion_cop']\n",
    "\n",
    "# La parte importada del costo escala con el mismo tipo de cambio que el ingreso (COPCAD de\n",
    "# cada escenario, dividido entre el COPCAD base); la parte nacional y el costo logistico NO\n",
    "# escalan -se mantienen en el mismo peso nominal que en la Etapa 6.\n",
    "tabla_cob['costo_importado_esc'] = tabla_cob['costo_importado_base'] * (tabla_cob['COPCAD'] / copcad_base)\n",
    "tabla_cob['costo_total_ajustado'] = tabla_cob['costo_importado_esc'] + tabla_cob['costo_nacional'] + tabla_cob['costo_logistico']\n",
    "\n",
    "tabla_cob['margen_cop_ajustado'] = tabla_cob['ingreso_cop'] - tabla_cob['costo_total_ajustado']\n",
    "tabla_cob['margen_pct_ajustado'] = tabla_cob['margen_cop_ajustado'] / tabla_cob['ingreso_cop'] * 100\n",
    "\n",
    "print('Columnas nuevas calculadas:',\n",
    "      ['costo_importado_base', 'costo_nacional', 'costo_logistico', 'costo_importado_esc',\n",
    "       'costo_total_ajustado', 'margen_cop_ajustado', 'margen_pct_ajustado'])\n",
    "tabla_cob[['producto', 'ruta', 'escenario', 'margen_pct', 'margen_pct_ajustado']].head(6)"
   ]
  },
