    "# Cargar tabla_B4_precios_referencia (Tarea 4, Bloque A)\n",
    "#\n",
    "# El archivo tiene los encabezados corridos por un problema de codificacion en el\n",
    "# origen (los acentos quedaron guardados como caracter de reemplazo, ej. 'N�mero'\n",
    "# en vez de 'Numero', 'C�digo HS' en vez de 'Codigo HS'). Se renombra por POSICION,\n",
    "# no copiando el texto exacto de la columna, para no depender de como haya quedado\n",
    "# corrupto el encabezado ni arrastrar ese problema al resto del notebook.\n",
    "\n",
    "productos = pd.read_excel('../dataraw/2tabla_B4_precios_referencia.xlsx')\n",
    "\n",
    "print(f'Columnas originales ({len(productos.columns)}): {list(productos.columns)}')\n",
    "\n",
    "productos.columns = [\n",
    "    'numero', 'producto', 'codigo_hs', 'precio_usd', 'unidad_metrica',\n",
    "    'tipo_cambio_usd_cad', 'precio_cad', 'fuente', 'fecha_consulta',\n",
    "]\n",
    "\n",
    "print(f'\\nProductos cargados: {len(productos)} (esperado 10)')\n",
    "productos[['numero', 'producto', 'codigo_hs', 'unidad_metrica', 'precio_cad']]"
   ]
