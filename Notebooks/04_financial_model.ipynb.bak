    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Volatilidad diaria: 0.9468%\n",
      "Volatilidad anualizada: 15.0299%\n",
      "\n",
      "Verificacion 1 - Volatilidad en rango 8%-18%: True\n",
      "Verificacion 2 - OK: volatilidad no esta sospechosamente baja (>= 5%)\n",
      "Verificacion 3 - OK: volatilidad no esta sospechosamente alta (<= 25%)\n"
     ]
    }
   ],
   "source": [
    "# Calculo de la volatilidad diaria (desviacion estandar de los retornos logaritmicos)\n",
    "volatilidad_diaria = cop_cad_df['retorno_log'].std()\n",
    "\n",
    "# Anualizacion: se asume ~252 dias habiles de mercado por año\n",
    "volatilidad_anualizada = volatilidad_diaria * np.sqrt(252)\n",
    "\n",
    "print(f'Volatilidad diaria: {volatilidad_diaria:.4%}')\n",
    "print(f'Volatilidad anualizada: {volatilidad_anualizada:.4%}')\n",
    "\n",
    "# --- Verificaciones de calidad ---\n",
    "\n",
    "# Verificacion 1: rango esperado segun Seccion 3.3 (8% - 18%)\n",
    "en_rango_esperado = 0.08 <= volatilidad_anualizada <= 0.18\n",
    "print(f'\\nVerificacion 1 - Volatilidad en rango 8%-18%: {en_rango_esperado}')\n",
    "\n",
    "# Verificacion 2: valor sospechosamente bajo (<5%) -> posible error de calculo\n",
    "# (por ejemplo, usar diferencia simple en vez de cambio porcentual logaritmico)\n",
    "if volatilidad_anualizada < 0.05:\n",
    "    print('Verificacion 2 - ALERTA: volatilidad por debajo de 5%, revisar si se uso '\n",
    "          'diferencia simple en lugar de retorno logaritmico')\n",
    "else:\n",
    "    print('Verificacion 2 - OK: volatilidad no esta sospechosamente baja (>= 5%)')\n",
    "\n",
    "# Verificacion 3: valor sospechosamente alto (>25%) -> posible outlier sin corregir\n",
    "if volatilidad_anualizada > 0.25:\n",
    "    print('Verificacion 3 - ALERTA: volatilidad por encima de 25%, revisar valores '\n",
    "          'atipicos en COP_CAD (posible error en TRM o USD/CAD del Bloque A)')\n",
    "    outliers = cop_cad_df.loc[cop_cad_df['retorno_log'].abs() > cop_cad_df['retorno_log'].std() * 4]\n",
    "    print(f'Retornos diarios que exceden 4 desviaciones estandar ({len(outliers)} casos):')\n",
    "    print(outliers[['fecha', 'COP_CAD', 'retorno_log']])\n",
    "else:\n",
    "    print('Verificacion 3 - OK: volatilidad no esta sospechosamente alta (<= 25%)')\n"
   ]
  },
