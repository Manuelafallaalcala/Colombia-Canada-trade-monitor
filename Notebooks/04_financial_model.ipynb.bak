   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Verificacion 1 - orden optimista > base > pesimista, por producto y ruta:\n",
      "orden_correcto\n",
      "True    20\n",
      "Name: count, dtype: int64\n",
      "Combinaciones producto-ruta esperadas: 20 = 20\n",
      "\n",
      "Verificacion 2 - costo_total_cop identico en los 3 escenarios, por producto+ruta: True (20 de 20 combinaciones)\n",
      "\n",
      "Verificacion 3 - ningun ingreso_cop es cero: True\n",
      "\n",
      "Verificacion 4 - rango de margen_pct observado (todas las filas): -348.6% a 45.3%\n",
      "\n",
      "ALERTA - 1 producto(s) con margen fuera de -100%/+100%:\n",
      "                     min   max\n",
      "producto                      \n",
      "Carbón bituminoso -348.6 -12.4\n",
      "\n",
      "Diagnostico: revisando el detalle, el unico producto fuera de rango es el carbon\n",
      "(HS 2701, Carbon bituminoso). Es un commodity de muy bajo valor por kilogramo\n",
      "(0.088 USD/kg de precio de referencia) que en la practica real se transporta a\n",
      "GRANEL (bulk carrier, miles de toneladas por embarque), no en contenedor. Al\n",
      "aplicarle la tarifa de flete en contenedor -calculada para carga general de mayor\n",
      "valor, ver celdas anteriores- el costo logistico por kilogramo queda muy por\n",
      "encima de lo que el carbon realmente vale, y el margen sale negativo sin sentido\n",
      "economico (hasta -348% en la ruta a Vancouver). No es un error de calculo: es un\n",
      "limite real de usar tarifas de contenedor para un commodity que no se transporta\n",
      "asi. Los otros 9 productos SI quedan en un rango razonable (ver resumen abajo).\n",
      "\n",
      "Rango de margen_pct por producto (min a max entre los 3 escenarios y 2 rutas):\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "                                              min   max\n",
      "producto                                               \n",
      "Carbón bituminoso                          -348.6 -12.4\n",
      "Frutas tropicales (guayaba/mango)             1.7  41.2\n",
      "Accesorios tubería hierro/acero              13.6  43.0\n",
      "Flores frescas otras (pompones/hortensias)   16.1  43.4\n",
      "Rosas frescas cortadas                       17.5  43.6\n",
      "Café sin tostar                              19.0  43.9\n",
      "Nueces y semillas preparadas                 21.7  44.3\n",
      "Filetes de trucha congelados                 23.4  44.5\n",
      "Medias/calcetines fibra sintética            24.5  44.7\n",
      "Medicamentos corticosteroides                28.2  45.3\n"
     ]
    }
   ],
   "source": [
    "# Verificaciones de calidad (Seccion 7.6.6)\n",
    "\n",
    "# 1) Orden logico: margen optimista > margen base > margen pesimista, para cada\n",
    "#    combinacion de producto y ruta (20 combinaciones = 10 productos x 2 rutas)\n",
    "verificacion = tabla_margenes.pivot_table(index=[\"producto\", \"ruta\"], columns=\"escenario\", values=\"margen_pct\")\n",
    "verificacion[\"orden_correcto\"] = (verificacion[\"Optimista\"] > verificacion[\"Base\"]) & (verificacion[\"Base\"] > verificacion[\"Pesimista\"])\n",
    "print(\"Verificacion 1 - orden optimista > base > pesimista, por producto y ruta:\")\n",
    "print(verificacion[\"orden_correcto\"].value_counts())\n",
    "print(f\"Combinaciones producto-ruta esperadas: {10 * 2} = 20\")\n",
    "\n",
    "# 2) El costo total (produccion + logistica) debe ser identico en los 3 escenarios,\n",
    "#    para cada producto y cada ruta -solo el ingreso cambia con el tipo de cambio,\n",
    "#    el costo no. Es la misma verificacion de la Tarea 5 del Bloque A (Seccion\n",
    "#    6.5.6), adaptada a que aqui el costo tambien varia por ruta (no solo por\n",
    "#    producto), porque cada ruta tiene su propio costo logistico.\n",
    "costo_constante = tabla_margenes.groupby([\"producto\", \"ruta\"])[\"costo_total_cop\"].nunique()\n",
    "print()\n",
    "print(f\"Verificacion 2 - costo_total_cop identico en los 3 escenarios, por producto+ruta: \"\n",
    "      f\"{(costo_constante == 1).all()} ({(costo_constante == 1).sum()} de {len(costo_constante)} combinaciones)\")\n",
    "\n",
    "# 3) Ningun ingreso en COP igual a cero (evita division por cero en margen_pct)\n",
    "print()\n",
    "print(f\"Verificacion 3 - ningun ingreso_cop es cero: {(tabla_margenes['ingreso_cop'] != 0).all()}\")\n",
    "\n",
    "# 4) Rango razonable de margen_pct por PRODUCTO (no por fila individual), para poder\n",
    "#    aislar cual producto especifico es el responsable si algo sale fuera de rango,\n",
    "#    en vez de solo reportar un True/False global que no dice donde esta el problema.\n",
    "rango_por_producto = tabla_margenes.groupby(\"producto\")[\"margen_pct\"].agg([\"min\", \"max\"])\n",
    "fuera_de_rango = rango_por_producto[(rango_por_producto[\"min\"] < -100) | (rango_por_producto[\"max\"] > 100)]\n",
    "\n",
    "print()\n",
    "print(f\"Verificacion 4 - rango de margen_pct observado (todas las filas): \"\n",
    "      f\"{tabla_margenes['margen_pct'].min():.1f}% a {tabla_margenes['margen_pct'].max():.1f}%\")\n",
    "\n",
    "if len(fuera_de_rango) > 0:\n",
    "    print()\n",
    "    print(f\"ALERTA - {len(fuera_de_rango)} producto(s) con margen fuera de -100%/+100%:\")\n",
    "    print(fuera_de_rango.round(1).to_string())\n",
    "    print()\n",
    "    print(\"Diagnostico: revisando el detalle, el unico producto fuera de rango es el carbon\")\n",
    "    print(\"(HS 2701, Carbon bituminoso). Es un commodity de muy bajo valor por kilogramo\")\n",
    "    print(\"(0.088 USD/kg de precio de referencia) que en la practica real se transporta a\")\n",
    "    print(\"GRANEL (bulk carrier, miles de toneladas por embarque), no en contenedor. Al\")\n",
    "    print(\"aplicarle la tarifa de flete en contenedor -calculada para carga general de mayor\")\n",
    "    print(\"valor, ver celdas anteriores- el costo logistico por kilogramo queda muy por\")\n",
    "    print(\"encima de lo que el carbon realmente vale, y el margen sale negativo sin sentido\")\n",
    "    print(\"economico (hasta -348% en la ruta a Vancouver). No es un error de calculo: es un\")\n",
    "    print(\"limite real de usar tarifas de contenedor para un commodity que no se transporta\")\n",
    "    print(\"asi. Los otros 9 productos SI quedan en un rango razonable (ver resumen abajo).\")\n",
    "else:\n",
    "    print()\n",
    "    print(\"Verificacion 4 - todos los productos dentro de un rango razonable (-100% a 100%): OK\")\n",
    "\n",
    "print()\n",
    "print(\"Rango de margen_pct por producto (min a max entre los 3 escenarios y 2 rutas):\")\n",
    "print(rango_por_producto.round(1).sort_values(\"min\").to_string())\n"
   ]
  },
