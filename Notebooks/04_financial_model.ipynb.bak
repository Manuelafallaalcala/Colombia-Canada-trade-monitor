   "source": [
    "# Cargar TRM COP/USD desde archivo local\n",
    "trm_df = pd.read_excel('../dataraw/TRM_COP_USD_2020_2024.xlsx', sheet_name='Datos COP-USD')\n",
    "trm_df = trm_df.rename(columns={'Fecha (aaaa/mm/dd)': 'fecha', 'TRM': 'TRM_COP_USD'})\n",
    "trm_df['fecha'] = pd.to_datetime(trm_df['fecha'])\n",
    "trm_df = trm_df.sort_values('fecha').reset_index(drop=True)\n",
    "\n",
    "print(f'Registros TRM: {len(trm_df)}')\n",
    "trm_df.head(10)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "d64636c5",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-24T01:17:34.262578Z",
     "iopub.status.busy": "2026-07-24T01:17:34.262293Z",
     "iopub.status.idle": "2026-07-24T01:17:34.557791Z",
     "shell.execute_reply": "2026-07-24T01:17:34.556431Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Registros combinados: 1246, promedio COP/CAD: 3035.41\n",
      "COP/CAD minimo: 2488.28\n",
      "COP/CAD maximo: 3765.50\n",
      "Rango dentro de lo esperado (2.300-3800): True\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Archivo guardado en: ../outputs/fx_cop_usd_cad.xlsx\n"
     ]
    }
   ],
   "source": [
    "# Combinar TRM (COP/USD) con USD/CAD para construir la tasa cruzada COP/CAD\n",
    "cop_cad_df = pd.merge(trm_df, boc_df, on='fecha', how='inner')\n",
    "\n",
    "# Tasa cruzada: COP/CAD = COP/USD * USD/CAD\n",
    "# boc_df['USDCAD'] es CAD por 1 USD -> USD/CAD = 1 / USDCAD\n",
    "cop_cad_df['USD_CAD'] = 1 / cop_cad_df['USDCAD']\n",
    "cop_cad_df['COP_CAD'] = cop_cad_df['TRM_COP_USD'] * cop_cad_df['USD_CAD']\n",
    "\n",
    "cop_cad_df = cop_cad_df[['fecha', 'TRM_COP_USD', 'USDCAD', 'USD_CAD', 'COP_CAD']]\n",
    "print(f'Registros combinados: {len(cop_cad_df)}, promedio COP/CAD: {cop_cad_df[\"COP_CAD\"].mean():.2f}')\n",
    "cop_cad_df.head(10)\n",
    "# Estadisticas resumen de la serie fx (COP/USD, USD/CAD, COP/CAD)\n",
    "resumen = cop_cad_df.describe()\n",
    "resumen\n",
    "# Validar que COP/CAD esta en el rango esperado (~2.300 a 3.800)\n",
    "cop_cad_min = cop_cad_df['COP_CAD'].min()\n",
    "cop_cad_max = cop_cad_df['COP_CAD'].max()\n",
    "\n",
    "print(f'COP/CAD minimo: {cop_cad_min:.2f}')\n",
    "print(f'COP/CAD maximo: {cop_cad_max:.2f}')\n",
    "\n",
    "rango_ok = 2300 <= cop_cad_min and cop_cad_max <= 3800\n",
    "print('Rango dentro de lo esperado (2.300-3800):', rango_ok)\n",
    "# Guardar la tabla fx (COP/USD, USD/CAD, COP/CAD) como Excel en outputs\n",
    "import os\n",
    "\n",
    "os.makedirs('../outputs', exist_ok=True)\n",
    "ruta_salida = '../outputs/fx_cop_usd_cad.xlsx'\n",
    "cop_cad_df.to_excel(ruta_salida, index=False, sheet_name='fx_cop_usd_cad')\n",
    "\n",
    "print(f'Archivo guardado en: {ruta_salida}')\n",
    "\n"
   ]
  },
