      "Beneficio total de Drawback sumado sobre las 20 combinaciones producto-ruta (escenario Base): 28,236.26 COP\n",
      "\n",
      "Carbon bituminoso y Accesorios tuberia hierro/acero (drawback_aplica = \"No esta claro\") quedan\n",
      "en beneficio_drawback_cop = 0 en las tres rutas -su margen negativo (Etapas 6/7) es un problema\n",
      "estructural de costo logistico, no algo que el Drawback pueda o deba corregir.\n"
     ]
    }
   ],
   "source": [
    "# Enriquecimiento 2: beneficio de Drawback como porcentaje del ingreso (escenario Base), para\n",
    "# comparar en la misma escala relativa que el costo de capital (Etapa 10) y el costo de\n",
    "# cobertura cambiaria (Etapa 11) -las tres fricciones/beneficios financieros del modelo quedan\n",
    "# expresadas en la misma unidad, permitiendo comparar su magnitud directamente.\n",
    "\n",
    "base_drawback = tabla_drawback.loc[tabla_drawback['escenario'] == 'Base'].drop_duplicates('producto').copy()\n",
    "base_drawback['beneficio_drawback_pct_ingreso'] = base_drawback['beneficio_drawback_cop'] / base_drawback['ingreso_cop'] * 100\n",
    "ranking_drawback = base_drawback.loc[\n",
    "    base_drawback['aplica_si'],\n",
    "    ['producto', 'ruta', 'pct_importado', 'beneficio_drawback_cop', 'beneficio_drawback_pct_ingreso']\n",
    "].sort_values('beneficio_drawback_pct_ingreso', ascending=False)\n",
    "\n",
    "print('Ranking de beneficio de Drawback como % del ingreso (escenario Base, solo productos donde aplica):')\n",
    "print(ranking_drawback.round(2).to_string(index=False))\n",
    "\n",
    "beneficio_total_portafolio = tabla_drawback.loc[tabla_drawback['escenario'] == 'Base', 'beneficio_drawback_cop'].sum()\n",
    "print(f'\\nBeneficio total de Drawback sumado sobre las 20 combinaciones producto-ruta (escenario Base): {beneficio_total_portafolio:,.2f} COP')\n",
    "\n",
    "print('\\nCarbon bituminoso y Accesorios tuberia hierro/acero (drawback_aplica = \"No esta claro\") quedan')\n",
    "print('en beneficio_drawback_cop = 0 en las tres rutas -su margen negativo (Etapas 6/7) es un problema')\n",
    "print('estructural de costo logistico, no algo que el Drawback pueda o deba corregir.')\n"
   ]
  },
