   ],
   "source": [
    "# Enriquecimiento 1: repetir la misma comparacion usando los otros dos criterios de perdida\n",
    "# (ES y peor historico real, calculados en la primera celda de esta etapa) en vez de solo el\n",
    "# VaR, para ver si la recomendacion es robusta al criterio de riesgo elegido -no solo al VaR,\n",
    "# que es apenas uno de tres puntos de vista razonables sobre la misma pregunta.\n",
    "\n",
    "resumen_criterios = []\n",
    "for dias in [30, 60, 90]:\n",
    "    costo_pct = abs(tabla_cobertura[f'puntos_forward_pct_{dias}d'].iloc[0])\n",
    "    for nombre_criterio, perdida_dict in [\n",
    "        ('VaR 95%', var_dict), ('Expected Shortfall 95%', es_dict), ('Peor historico real', peor_historico_dict)\n",
    "    ]:\n",
    "        perdida_pct = abs(perdida_dict[dias])\n",
    "        resumen_criterios.append({\n",
    "            'horizonte_dias': dias, 'criterio_de_perdida': nombre_criterio,\n",
    "            'costo_cobertura_pct': costo_pct, 'perdida_pct': perdida_pct,\n",
    "            'recomendacion': 'Cubrirse' if costo_pct < perdida_pct else 'No cubrirse',\n",
    "        })\n",
    "\n",
    "tabla_criterios = pd.DataFrame(resumen_criterios)\n",
    "print('Recomendacion bajo los tres criterios de perdida, por horizonte (identica para los 10 '\n",
    "      'productos dentro de cada combinacion horizonte-criterio, por la misma razon algebraica '\n",
    "      'de la celda anterior):')\n",
    "print(tabla_criterios.round(4).to_string(index=False))\n",
    "\n",
    "robustez = tabla_criterios.groupby('horizonte_dias')['recomendacion'].nunique()\n",
    "print('\\nVerificacion de robustez - valores distintos de recomendacion bajo los 3 criterios, '\n",
    "      'por horizonte (1 = la conclusion no depende del criterio de riesgo elegido; 2 o 3 = si '\n",
    "      'depende):')\n",
    "print(robustez.to_string())"
   ]
  },
