   ],
   "source": [
    "# Resumen accionable: que porcentaje del margen bruto (Etapa 6) se \"come\" el costo financiero\n",
    "# a 90 dias, por producto, en el escenario Base -la pregunta que realmente le importa a un\n",
    "# exportador antes de aceptar un plazo de pago largo con su comprador canadiense.\n",
    "\n",
    "base_capital = tabla_capital[tabla_capital['escenario'] == 'Base'].copy()\n",
    "base_capital['pct_margen_consumido_90d'] = np.where(\n",
    "    base_capital['margen_cop'] > 0, base_capital['costo_financiero_90d'] / base_capital['margen_cop'] * 100, np.nan\n",
    ")\n",
    "\n",
    "resumen_consumo = base_capital[\n",
    "    ['producto', 'ruta', 'margen_cop', 'costo_financiero_90d', 'pct_margen_consumido_90d']\n",
    "].sort_values('pct_margen_consumido_90d', ascending=False)\n",
    "\n",
    "print('Porcentaje del margen bruto (escenario Base) que se pierde en costo financiero a 90 '\n",
    "      'dias, por producto y ruta (de mayor a menor impacto; NaN = margen base ya negativo, '\n",
    "      'el ratio no aplica -ver Etapa 6/7, es el caso del carbon):')\n",
    "print(resumen_consumo.round(2).to_string(index=False))"
   ]
  },
