   "source": [
    "# Enriquecimiento sobre el minimo pedido por la guia (Seccion 7.7): el semaforo da una\n",
    "# categoria (Verde/Amarillo/Rojo), pero no dice CUANTO margen de maniobra tiene cada\n",
    "# producto dentro de su propia categoria. Se agrega el \"colchon cambiario\": la distancia\n",
    "# entre el COP/CAD base actual y el breakeven de cada producto, en pesos y en porcentaje.\n",
    "# Es la pregunta que realmente se hace un tesorero con presupuesto limitado para forwards o\n",
    "# NDF: \"de los productos que todavia estan en Verde, cuales tienen MENOS margen y deberian\n",
    "# revisarse primero si el tipo de cambio empieza a moverse en contra?\"\n",
    "\n",
    "for ruta, col_breakeven in [('mtl', 'breakeven_mtl'), ('yvr', 'breakeven_yvr')]:\n",
    "    col_colchon_cop = f'colchon_cop_{ruta}'\n",
    "    col_colchon_pct = f'colchon_pct_{ruta}'\n",
    "    productos[col_colchon_cop] = copcad_base - productos[col_breakeven]\n",
    "    productos[col_colchon_pct] = productos[col_colchon_cop] / copcad_base * 100\n",
    "\n",
    "print('Colchon cambiario = COP/CAD base menos breakeven (en pesos y en % del COP/CAD base).')\n",
    "print('Un colchon negativo significa que el producto YA esta por debajo de su propio punto '\n",
    "      'de equilibrio al COP/CAD base actual (margen negativo incluso sin ningun choque '\n",
    "      'cambiario adicional).\\n')\n",
    "productos[['producto', 'colchon_pct_mtl', 'colchon_pct_yvr']].sort_values('colchon_pct_mtl').round(1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "a2422b12",
   "metadata": {
