   "source": [
    "# Resumen consolidado de metricas de riesgo cambiario COP/CAD\n",
    "resumen_riesgo = pd.DataFrame({\n",
    "    'Metrica': [\n",
    "        'VaR historico 1 dia (95%)',\n",
    "        'VaR historico 1 dia (99%)',\n",
