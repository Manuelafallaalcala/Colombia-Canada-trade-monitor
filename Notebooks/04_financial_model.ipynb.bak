      "             Medicamentos corticosteroides  CTG-Montreal    45881.32         15915.06                        34.69\n",
      "                         Carbón bituminoso  CTG-Montreal      -85.60            50.02                          NaN\n",
      "                         Carbón bituminoso CTG-Vancouver    -1019.31            50.02                          NaN\n",
      "\n",
      "(NaN = margen base ya negativo -el caso del carbon, donde la pregunta de cobertura cambiaria es secundaria frente al problema estructural de costos ya documentado desde la Etapa 6)\n"
     ]
    }
   ],
   "source": [
    "# Enriquecimiento 2: aunque la decision \"cubrirse si/no\" es identica para todos los productos\n",
    "# (celdas anteriores), la CONSECUENCIA de no cubrirse SI varia mucho por producto, porque\n",
    "# perdida_var_Xd (en pesos) representa una porcion muy distinta del margen de cada producto\n",
    "# -no todos tienen el mismo margen para absorber el mismo golpe cambiario. Esta es la pregunta\n",
    "# realmente accionable para una PYME con presupuesto limitado para forwards: si solo puedo\n",
    "# cubrir algunos productos, cuales primero?\n",
    "#\n",
    "# vulnerabilidad_relativa_Xd = perdida_var_Xd (COP) / margen_cop (COP), en el escenario Base\n",
    "# -que tan grande es la perdida potencial comparada con la utilidad que realmente se esta\n",
    "# jugando ese producto, no comparada con su ingreso total.\n",
    "\n",
    "base_cobertura = tabla_cobertura[tabla_cobertura['escenario'] == 'Base'].copy()\n",
    "for dias in [30, 60, 90]:\n",
    "    base_cobertura[f'vulnerabilidad_relativa_{dias}d'] = np.where(\n",
    "        base_cobertura['margen_cop'] > 0,\n",
    "        base_cobertura[f'perdida_var_{dias}d'] / base_cobertura['margen_cop'] * 100,\n",
    "        np.nan,\n",
    "    )\n",
    "\n",
    "ranking_vulnerabilidad = base_cobertura[\n",
    "    ['producto', 'ruta', 'margen_cop', 'perdida_var_90d', 'vulnerabilidad_relativa_90d']\n",
    "].sort_values('vulnerabilidad_relativa_90d', ascending=False)\n",
    "\n",
    "print('Ranking de vulnerabilidad relativa a 90 dias (perdida potencial VaR como % del propio '\n",
    "      'margen, escenario Base) -de mas a menos urgente para priorizar cobertura:')\n",
    "print(ranking_vulnerabilidad.round(2).to_string(index=False))\n",
    "print('\\n(NaN = margen base ya negativo -el caso del carbon, donde la pregunta de cobertura '\n",
    "      'cambiaria es secundaria frente al problema estructural de costos ya documentado desde '\n",
    "      'la Etapa 6)')"
   ]
  },
