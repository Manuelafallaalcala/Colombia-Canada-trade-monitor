   ],
   "source": [
    "# ============================================================\n",
    "# Figura 8: Margen bruto vs ajustado por cobertura natural y Drawback (Seccion 8.5 de la guia)\n",
    "# ============================================================\n",
    "# Se usa tabla_drawback (Etapa 12, en memoria), la unica tabla del notebook que tiene las 3\n",
    "# columnas -margen_pct, margen_pct_ajustado, margen_final_pct- en la misma fila. No se usa\n",
    "# tabla_margenes (que la guia menciona de forma literal) porque en este notebook cada etapa\n",
    "# construye su propia tabla derivada en vez de mutar tabla_margenes en el sitio -decision de\n",
    "# diseno ya documentada desde la introduccion de la Etapa 6.\n",
    "#\n",
    "# Enriquecimiento sobre el codigo base de la guia: los productos se ordenan por margen_final_pct\n",
    "# ascendente (el numero mas completo del modelo), en vez del orden alfabetico por defecto de\n",
    "# groupby, para que la figura misma comunique de un vistazo cuales productos siguen en riesgo\n",
    "# incluso despues de los tres ajustes acumulados.\n",
    "\n",
    "datos_pes = tabla_drawback[tabla_drawback['escenario'] == 'Pesimista'].groupby('producto')[[\n",
    "    'margen_pct', 'margen_pct_ajustado', 'margen_final_pct']].mean()\n",
    "datos_pes = datos_pes.sort_values('margen_final_pct')\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(13, 7))\n",
    "datos_pes.plot(kind='bar', ax=ax, color=['#C00000', '#BF8F00', '#375623'])\n",
    "ax.axhline(y=0, color='black', linestyle='--', linewidth=1)\n",
    "ax.set_ylabel('Margen (%)')\n",
    "ax.set_xlabel('')\n",
    "ax.set_title('Margen pesimista: bruto vs ajustado por cobertura natural y Drawback', fontweight='bold')\n",
    "ax.tick_params(axis='x', rotation=75)\n",
    "\n",
    "# Se pasan los handles de forma EXPLICITA (ax.containers, en vez de dejar que ax.legend()\n",
    "# adivine que artistas de los ejes corresponden a cada etiqueta). Con solo una lista de\n",
    "# etiquetas, matplotlib puede emparejar las etiquetas con el orden interno de artistas de los\n",
    "# ejes -que incluye la linea de ax.axhline()- y no necesariamente con el orden de las 3 barras\n",
    "# como se pretendia; ya se detecto ese emparejamiento incorrecto al revisar la figura de forma\n",
    "# visual (la linea de referencia en cero terminaba etiquetada como \"Margen bruto\"), asi que se\n",
    "# corrige aqui indicando los handles explicitamente, un patron mas robusto entre versiones de\n",
    "# matplotlib -mismo tipo de fragilidad ya visto con el argumento 'labels' de boxplot en la\n",
    "# Etapa 9.\n",
    "ax.legend(ax.containers, ['Margen bruto (sin ajustar)', 'Margen ajustado (cobertura natural)', 'Margen final (con Drawback)'])\n",
    "\n",
    "plt.tight_layout()\n",
    "ruta_figura08 = '../outputs/figures/figura_08_margen_bruto_vs_ajustado.png'\n",
    "plt.savefig(ruta_figura08, dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "# Verificacion (Sub-paso 2 de la guia, convertido en chequeo automatico en vez de una revision\n",
    "# visual): la progresion debe ser monotona (bruto <= ajustado <= final) en los 10 productos.\n",
    "# Para Carbon y Accesorios (Drawback no aplica, Etapa 12), ajustado debe ser igual a final.\n",
    "progresion_ok = bool(\n",
    "    (datos_pes['margen_pct'] <= datos_pes['margen_pct_ajustado'] + 1e-9).all()\n",
    "    and (datos_pes['margen_pct_ajustado'] <= datos_pes['margen_final_pct'] + 1e-9).all()\n",
    ")\n",
    "print(f'Figura guardada en: {ruta_figura08}')\n",
    "print(f'Verificacion - progresion monotona bruto <= ajustado <= final, en los 10 productos: {progresion_ok}')\n"
   ]
  },
