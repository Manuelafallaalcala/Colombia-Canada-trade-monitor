   "source": [
    "# Diagnostico visual (NO se guarda en outputs/figures -esa carpeta y el formato de 150 dpi son\n",
    "# del Bloque C, Figura 7, que se construye mas adelante; esta es una vista rapida dentro del\n",
    "# propio Bloque B para inspeccionar el resultado antes de cerrar la etapa).\n",
    "#\n",
    "# Se excluye el carbon bituminoso del grafico principal: su escala (hasta -300%, ver Etapa 6)\n",
    "# aplastaria visualmente la variacion, mucho mas moderada, de los otros 9 productos. Se reporta\n",
    "# aparte, en texto, justo despues del grafico.\n",
    "\n",
    "orden_episodios = episodios.sort_values('COPCAD_implicado')['nombre_episodio'].tolist()\n",
    "datos_sin_carbon = tabla_stress[tabla_stress['producto'] != 'Carbón bituminoso']\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(11, 5))\n",
    "datos_por_episodio = [datos_sin_carbon.loc[datos_sin_carbon['episodio'] == ep, 'margen_pct'] for ep in orden_episodios]\n",
    "ax.boxplot(datos_por_episodio)\n",
    "ax.set_xticklabels([e.replace(' ', '\\n', 1) for e in orden_episodios])\n",
    "ax.axhline(0, color='red', linestyle='--', linewidth=1, label='Margen = 0 (breakeven)')\n",
    "ax.set_title('Distribucion del margen_pct bajo cada episodio historico (9 productos x 2 rutas, sin carbon)')\n",
    "ax.set_ylabel('Margen (%)')\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print('Carbon bituminoso (excluido del grafico por escala) - margen_pct por episodio:')\n",
    "print(tabla_stress.loc[tabla_stress['producto'] == 'Carbón bituminoso',\n",
    "                        ['episodio', 'ruta', 'margen_pct']].round(1).to_string(index=False))"
   ]
