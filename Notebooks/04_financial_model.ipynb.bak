     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Verificacion 1 - todos los valores son finitos (sin NaN/inf): True\n",
      "Verificacion 1b - ningun ingreso_cop es cero: True\n",
      "\n",
      "Verificacion 2 - margen_pct coincide con un recalculo independiente: True\n",
      "\n",
      "Verificacion 3 - margen_pct crece estrictamente con COPCAD_stress en las 20 combinaciones producto-ruta (propiedad algebraica del modelo, no un patron empirico aproximado): True\n"
     ]
    }
   ],
   "source": [
    "# Verificaciones de calidad y de consistencia interna, mas alla del conteo de filas que pide\n",
    "# la guia de forma literal (Sub-paso 4, Seccion 7.9.2).\n",
    "\n",
    "# 1) Sin NaN/infinitos, y ningun ingreso en cero (evita division por cero en margen_pct).\n",
    "sin_invalidos = tabla_stress[['COPCAD_stress', 'ingreso_cop', 'margen_pct']].apply(lambda c: np.isfinite(c)).all().all()\n",
    "print(f'Verificacion 1 - todos los valores son finitos (sin NaN/inf): {sin_invalidos}')\n",
    "print(f'Verificacion 1b - ningun ingreso_cop es cero: {(tabla_stress[\"ingreso_cop\"] != 0).all()}')\n",
    "\n",
    "# 2) Identidad: recalcular margen_pct de forma independiente (no reutilizar la columna ya\n",
    "#    calculada) y comparar contra la que quedo guardada en la tabla.\n",
    "margen_recalculado = (tabla_stress['ingreso_cop'] - tabla_stress['costo_total_cop']) / tabla_stress['ingreso_cop'] * 100\n",
    "identidad_ok = np.allclose(tabla_stress['margen_pct'], margen_recalculado)\n",
    "print(f'\\nVerificacion 2 - margen_pct coincide con un recalculo independiente: {identidad_ok}')\n",
    "\n",
    "# 3) Monotonicidad algebraica (no una correlacion aproximada): para un producto y ruta fijos,\n",
    "#    costo_total_cop es EL MISMO en los 4 episodios (depende solo del producto/ruta, viene de\n",
    "#    la Etapa 6, no del episodio). Por lo tanto margen_pct = 100 - 100*costo_total/(precio_cad\n",
    "#    * COPCAD_stress) es una funcion estrictamente CRECIENTE de COPCAD_stress -pero es una\n",
    "#    funcion racional (1/x), no lineal, asi que una correlacion de Pearson NO tiene por que\n",
    "#    salir en 1.000 exacto aunque la relacion sea perfectamente monotonica. La prueba correcta\n",
    "#    es verificar la monotonicidad de forma directa (ordenar por COPCAD_stress y confirmar que\n",
    "#    margen_pct tambien queda ordenado), no apoyarse en un coeficiente de correlacion lineal\n",
    "#    que mediria la propiedad equivocada.\n",
    "def es_estrictamente_creciente(grupo):\n",
    "    g = grupo.sort_values('COPCAD_stress')\n",
    "    return bool(g['margen_pct'].is_monotonic_increasing) and g['margen_pct'].nunique() == len(g)\n",
    "\n",
    "monotonico_por_grupo = tabla_stress.groupby(['producto', 'ruta']).apply(es_estrictamente_creciente)\n",
    "todas_monotonicas = bool(monotonico_por_grupo.all())\n",
    "print(f'\\nVerificacion 3 - margen_pct crece estrictamente con COPCAD_stress en las '\n",
    "      f'{len(monotonico_por_grupo)} combinaciones producto-ruta (propiedad algebraica del '\n",
    "      f'modelo, no un patron empirico aproximado): {todas_monotonicas}')\n",
    "if not todas_monotonicas:\n",
    "    print(monotonico_por_grupo[~monotonico_por_grupo])"
   ]
  },
