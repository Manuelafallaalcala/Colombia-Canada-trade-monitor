    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "VaR historico diario 95%: -1.4552%\n",
      "VaR historico diario 99%: -2.2846%\n",
      "Incremento de perdida al exigir 99% en vez de 95%: 57.0%\n"
     ]
    }
   ],
   "source": [
    "# 2) VaR historico al 99% - segundo nivel de confianza (estandar dual en la practica)\n",
    "#\n",
    "# Ningun area de riesgo confia en un unico nivel de confianza. El 95% es el estandar\n",
    "# de uso diario (limites operativos internos, monitoreo); el 99% (o 99.9%) es el\n",
    "# estandar para capital regulatorio y escenarios de cola mas extrema. Comparar ambos\n",
    "# muestra que tan rapido crece la perdida potencial al exigir mayor confianza: si\n",
    "# crece desproporcionadamente, es señal de colas pesadas en la distribucion (validado\n",
    "# formalmente mas abajo con el test de Jarque-Bera).\n",
    "\n",
    "var_diario_99 = np.percentile(retornos, 1)  # percentil 1 -> 99% de confianza\n",
    "\n",
    "incremento_99_vs_95 = var_diario_99 / var_diario_95 - 1\n",
    "\n",
    "print(f'VaR historico diario 95%: {var_diario_95:.4%}')\n",
    "print(f'VaR historico diario 99%: {var_diario_99:.4%}')\n",
    "print(f'Incremento de perdida al exigir 99% en vez de 95%: {incremento_99_vs_95:.1%}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "2b12cb84",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-24T01:17:34.665595Z",
     "iopub.status.busy": "2026-07-24T01:17:34.665331Z",
     "iopub.status.idle": "2026-07-24T01:17:34.676344Z",
     "shell.execute_reply": "2026-07-24T01:17:34.674741Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Violaciones observadas: 63 de 1245 dias (5.06%)\n",
      "Violaciones esperadas (teoricas): 5.00%\n",
      "Estadistico LR de Kupiec: 0.0095\n",
      "p-value: 0.9225\n",
      "\n",
      "Modelo de VaR bien calibrado (no se rechaza H0 al 5%): True\n"
     ]
    }
   ],
   "source": [
    "# 3) Backtesting del VaR - Test de Kupiec (Proportion of Failures, POF)\n",
    "#\n",
    "# Ningun modelo de VaR sirve si no se valida contra la realidad. El backtesting\n",
    "# compara cuantas veces la perdida real \"violo\" el VaR (perdida real peor que el VaR\n",
    "# estimado ese dia) frente a cuantas veces DEBERIA haberlo hecho segun el nivel de\n",
    "# confianza. Con un VaR al 95% esperamos ~5% de violaciones:\n",
    "#   - Muchas mas violaciones de las esperadas -> el modelo SUBESTIMA el riesgo.\n",
    "#   - Muchas menos violaciones -> el modelo es demasiado conservador (ineficiente:\n",
    "#     exige mas capital/cobertura cambiaria de la necesaria).\n",
    "#\n",
    "# El test de Kupiec (1995) formaliza esto con un test de razon de verosimilitud (LR)\n",
    "# que, bajo la hipotesis nula de buena calibracion, sigue una distribucion\n",
    "# chi-cuadrado con 1 grado de libertad. Para no depender de librerias externas\n",
    "# (scipy no siempre esta instalado), usamos la forma cerrada exacta de la funcion\n",
    "# de distribucion chi-cuadrado con 1 g.l.: CDF_chi2_1(x) = erf(sqrt(x/2)).\n",
    "\n",
    "import math\n",
    "\n",
    "violaciones = int((retornos < var_diario_95).sum())\n",
    "n_obs = len(retornos)\n",
    "tasa_esperada = 1 - nivel_confianza          # 5% teorico\n",
    "tasa_observada = violaciones / n_obs          # % real de dias que violaron el VaR\n",
    "\n",
    "if 0 < tasa_observada < 1:\n",
    "    x, p, p_hat = violaciones, tasa_esperada, tasa_observada\n",
    "    lr_kupiec = -2 * (\n",
    "        (n_obs - x) * np.log(1 - p) + x * np.log(p)\n",
    "        - (n_obs - x) * np.log(1 - p_hat) - x * np.log(p_hat)\n",
    "    )\n",
    "    # max(lr_kupiec, 0) evita un dominio invalido en sqrt() por errores de redondeo\n",
    "    # de punto flotante (matematicamente LR siempre es >= 0)\n",
    "    p_value = 1 - math.erf(np.sqrt(max(lr_kupiec, 0) / 2))  # 1 - CDF chi2(df=1)\n",
    "else:\n",
    "    lr_kupiec, p_value = np.nan, np.nan\n",
    "\n",
    "print(f'Violaciones observadas: {violaciones} de {n_obs} dias ({tasa_observada:.2%})')\n",
    "print(f'Violaciones esperadas (teoricas): {tasa_esperada:.2%}')\n",
    "print(f'Estadistico LR de Kupiec: {lr_kupiec:.4f}')\n",
    "print(f'p-value: {p_value:.4f}')\n",
    "\n",
    "# Regla de decision: H0 = \"el modelo esta bien calibrado\". Se rechaza si p-value < 0.05\n",
    "modelo_bien_calibrado = p_value >= 0.05\n",
    "print(f'\\nModelo de VaR bien calibrado (no se rechaza H0 al 5%): {modelo_bien_calibrado}')\n",
    "if not modelo_bien_calibrado:\n",
    "    print('ALERTA: el numero de violaciones observadas se desvia significativamente de lo '\n",
    "          'esperado. Revisar si el periodo muestral mezcla regimenes de volatilidad muy '\n",
    "          'distintos (ver VaR movil a continuacion) antes de usar este VaR para limites.')\n"
   ]
  },
