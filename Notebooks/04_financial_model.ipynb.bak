      "\n",
      "\n",
      "Resumen por episodio (de las 20 combinaciones producto-ruta en cada uno):\n",
      "                                                 pct_cambio  combinaciones_con_perdida  margen_pct_promedio  margen_pct_peor\n",
      "episodio                                                                                                                    \n",
      "Apreciacion del peso 2022-2024                       -25.64                          3               -13.35          -412.83\n",
      "Choque pandemia COVID-19                              27.66                          1                33.97          -198.71\n",
      "Alza de tasas Fed e incertidumbre politica 2022       36.53                          1                38.26          -179.31\n",
      "Crisis petrolera 2014-2016                            80.81                          1                53.38          -110.91\n"
     ]
    }
   ],
   "source": [
    "# Funcionalidad adicional (no pedida de forma literal por la guia, pero que convierte el\n",
    "# numero abstracto de margen_pct en una pregunta binaria directamente accionable): cruzar\n",
    "# COPCAD_stress de cada episodio contra el breakeven de cada producto y ruta (Etapa 7) para\n",
    "# saber, episodio por episodio, cuales combinaciones producto-ruta dejarian de ser rentables.\n",
    "\n",
    "breakeven_por_ruta = {'CTG-Montreal': 'breakeven_mtl', 'CTG-Vancouver': 'breakeven_yvr'}\n",
    "tabla_stress['breakeven'] = tabla_stress.apply(\n",
    "    lambda r: productos.loc[productos['codigo_hs'] == r['codigo_hs'], breakeven_por_ruta[r['ruta']]].iloc[0], axis=1\n",
    ")\n",
    "tabla_stress['rompe_breakeven'] = tabla_stress['COPCAD_stress'] < tabla_stress['breakeven']\n",
    "\n",
    "# Verificacion de consistencia: rompe_breakeven (COPCAD_stress < breakeven) y margen_pct < 0\n",
    "# son, por construccion algebraica, la MISMA condicion economica expresada de dos formas\n",
    "# distintas -deben coincidir exactamente en el 100% de las filas. Si no coinciden, hay un\n",
    "# error en el calculo del breakeven (Etapa 7) o en el de esta etapa.\n",
    "coincide_signo = bool((tabla_stress['rompe_breakeven'] == (tabla_stress['margen_pct'] < 0)).all())\n",
    "print(f'Verificacion - rompe_breakeven coincide exactamente con margen_pct < 0 en las '\n",
    "      f'{len(tabla_stress)} filas: {coincide_signo}')\n",
    "\n",
    "resumen_por_episodio = tabla_stress.groupby('episodio').agg(\n",
    "    pct_cambio=('pct_cambio', 'first'),\n",
    "    combinaciones_con_perdida=('rompe_breakeven', 'sum'),\n",
    "    margen_pct_promedio=('margen_pct', 'mean'),\n",
    "    margen_pct_peor=('margen_pct', 'min'),\n",
    ").sort_values('pct_cambio')\n",
    "\n",
    "print('\\nResumen por episodio (de las 20 combinaciones producto-ruta en cada uno):')\n",
    "print(resumen_por_episodio.round(2).to_string())"
   ]
  },
  {
   "cell_type": "code",
