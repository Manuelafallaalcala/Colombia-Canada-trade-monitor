   "source": [
    "# Sub-paso 2 (Seccion 7.12.2), reforzado: la guia pide comparar el texto contra el literal\n",
    "# 'si'. Se agrega una normalizacion de texto (minusculas, sin tildes) para que la clasificacion\n",
    "# no dependa de si el archivo fuente guardo 'si', 'Si' o 'Si' con tilde -mas robusto que un\n",
    "# str.lower() simple, y no cambia el resultado ya verificado para estos 10 productos.\n",
    "\n",
    "import unicodedata\n",
    "\n",
    "def _normalizar_texto(valor):\n",
    "    texto = str(valor).strip().lower()\n",
    "    return ''.join(c for c in unicodedata.normalize('NFKD', texto) if not unicodedata.combining(c))\n",
    "\n",
    "drawback['aplica_si'] = drawback['drawback_aplica'].apply(_normalizar_texto) == 'si'\n",
    "\n",
    "print('Clasificacion final de los 10 productos:')\n",
    "print(drawback[['producto', 'drawback_aplica', 'aplica_si']].to_string(index=False))\n",
    "print(f'\\nProductos donde aplica el beneficio de Drawback: {drawback[\"aplica_si\"].sum()} de {len(drawback)}')\n"
   ]
  },
