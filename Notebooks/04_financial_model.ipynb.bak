   ],
   "source": [
    "# Enriquecimiento 1 (no pedido de forma literal por la guia): sintesis numerica de lo que la\n",
    "# Figura 8 del Bloque C (Seccion 8.5) mostrara de forma grafica -la progresion del margen a\n",
    "# traves de los tres ajustes sucesivos del modelo-, calculada aqui como tabla para cerrar el\n",
    "# Bloque B con una vista completa del efecto acumulado, en el escenario Pesimista.\n",
    "\n",
    "comparacion_pesimista = tabla_drawback.loc[\n",
    "    tabla_drawback['escenario'] == 'Pesimista',\n",
    "    ['producto', 'ruta', 'aplica_si', 'margen_pct', 'margen_pct_ajustado', 'margen_final_pct']\n",
    "].copy()\n",
    "comparacion_pesimista['mejora_cobertura_natural_pp'] = comparacion_pesimista['margen_pct_ajustado'] - comparacion_pesimista['margen_pct']\n",
    "comparacion_pesimista['mejora_drawback_pp'] = comparacion_pesimista['margen_final_pct'] - comparacion_pesimista['margen_pct_ajustado']\n",
    "comparacion_pesimista['mejora_total_pp'] = comparacion_pesimista['margen_final_pct'] - comparacion_pesimista['margen_pct']\n",
    "comparacion_pesimista = comparacion_pesimista.sort_values('mejora_total_pp', ascending=False)\n",
    "\n",
    "print('Progresion del margen (puntos porcentuales), escenario Pesimista, de mayor a menor mejora total:')\n",
    "print(comparacion_pesimista.round(2).to_string(index=False))\n",
    "\n",
    "# Verificacion de coherencia: la mejora total debe ser exactamente la suma de las dos mejoras parciales.\n",
    "suma_ok = np.allclose(\n",
    "    comparacion_pesimista['mejora_total_pp'],\n",
    "    comparacion_pesimista['mejora_cobertura_natural_pp'] + comparacion_pesimista['mejora_drawback_pp'],\n",
    ")\n",
    "print(f'\\nVerificacion - mejora_total_pp = mejora_cobertura_natural_pp + mejora_drawback_pp: {suma_ok}')\n"
   ]
  },
