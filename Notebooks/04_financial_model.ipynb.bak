     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Verificacion de robustez - valores distintos de recomendacion bajo los 3 criterios, por horizonte (1 = la conclusion no depende del criterio de riesgo elegido; 2 o 3 = si depende):\n",
      "horizonte_dias\n",
      "30    1\n",
      "60    1\n",
      "90    1\n"
     ]
