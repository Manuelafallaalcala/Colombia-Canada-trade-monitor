   ],
   "source": [
    "# Ranking de resiliencia por producto: a traves de los 4 episodios y las 2 rutas (8\n",
    "# combinaciones por producto), el peor margen observado y cuantas de esas 8 combinaciones\n",
    "# terminan en perdida (rompen breakeven). Es la version, con datos historicos reales, de la\n",
    "# misma pregunta que el semaforo de la Etapa 7 respondia con el VaR y el escenario pesimista\n",
    "# arbitrario.\n",
    "\n",
    "resiliencia = tabla_stress.groupby('producto').agg(\n",
    "    margen_pct_peor_historico=('margen_pct', 'min'),\n",
    "    margen_pct_promedio_historico=('margen_pct', 'mean'),\n",
    "    combinaciones_con_perdida=('rompe_breakeven', 'sum'),\n",
    ").reset_index()\n",
    "resiliencia['combinaciones_totales'] = len(episodios) * len(rutas)\n",
    "resiliencia = resiliencia.sort_values('margen_pct_peor_historico')\n",
    "\n",
    "print('Ranking de resiliencia por producto (de menos a mas resiliente bajo estres historico real):')\n",
    "print(resiliencia.round(2).to_string(index=False))"
   ]
  },
