   "source": [
    "# Sub-paso 3 (Seccion 7.9.2): aplicar cada episodio a los 10 productos x 2 rutas.\n",
    "#\n",
    "# Formula identica a la de los escenarios Optimista/Pesimista de la Etapa 6, solo que aqui\n",
    "# COPCAD_stress no es un +10%/-15% arbitrario sino el porcentaje de cambio REAL documentado en\n",
    "# cada episodio historico (tabla_B6). El costo total NO se ajusta por cobertura natural en\n",
    "# esta etapa -se aplica sobre el margen ORIGINAL de la Etapa 6, tal como especifica la guia; el\n",
    "# ajuste de cobertura natural (Etapa 8) es un modulo distinto y paralelo, no un insumo de este.\n",
    "\n",
    "filas_stress = []\n",
    "for _, ep in episodios.iterrows():\n",
    "    copcad_stress = copcad_base * (1 + ep['pct_cambio'] / 100)\n",
    "    for _, p in productos.iterrows():\n",
    "        for ruta, col_costo in rutas.items():\n",
    "            ingreso = p['precio_cad'] * copcad_stress\n",
    "            costo_total = p['costo_produccion_cop'] + p[col_costo]\n",
    "            margen_cop = ingreso - costo_total\n",
    "            margen_pct = margen_cop / ingreso * 100\n",
    "            filas_stress.append({\n",
    "                'episodio': ep['nombre_episodio'], 'tipo_movimiento': ep['tipo_movimiento'],\n",
    "                'pct_cambio': ep['pct_cambio'], 'producto': p['producto'], 'codigo_hs': p['codigo_hs'],\n",
    "                'ruta': ruta, 'COPCAD_stress': copcad_stress, 'ingreso_cop': ingreso,\n",
    "                'costo_total_cop': costo_total, 'margen_cop': margen_cop, 'margen_pct': margen_pct,\n",
    "            })\n",
    "\n",
    "tabla_stress = pd.DataFrame(filas_stress)\n",
    "\n",
    "filas_esperadas = len(episodios) * len(productos) * len(rutas)\n",
    "print(f'Filas generadas: {len(tabla_stress)} (esperado: {len(episodios)} episodios x '\n",
    "      f'{len(productos)} productos x {len(rutas)} rutas = {filas_esperadas})')\n",
    "assert len(tabla_stress) == filas_esperadas\n",
    "\n",
    "tabla_stress.head(6)"
   ]
  },
