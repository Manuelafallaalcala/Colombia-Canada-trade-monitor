   "source": [
    "# Sub-paso 1 (Seccion 7.7.2 de la guia): tipo de cambio de equilibrio (breakeven).\n",
    "#\n",
    "# Se despeja del punto en el que el margen neto es cero, es decir, ingreso = costo total:\n",
    "#   precio_cad * COPCAD_breakeven = costo_produccion_cop + costo_logistico\n",
    "#   COPCAD_breakeven = (costo_produccion_cop + costo_logistico) / precio_cad\n",
    "#\n",
    "# Se calcula por separado para cada ruta porque cada una tiene su propio costo logistico\n",
    "# (costo_logistico_mtl vs costo_logistico_yvr, ya calculados en la Etapa 6).\n",
    "\n",
    "productos['breakeven_mtl'] = (productos['costo_produccion_cop'] + productos['costo_logistico_mtl']) / productos['precio_cad']\n",
    "productos['breakeven_yvr'] = (productos['costo_produccion_cop'] + productos['costo_logistico_yvr']) / productos['precio_cad']\n",
    "\n",
    "print(f'COP/CAD base actual (Etapa 6, para referencia): {copcad_base:.2f}')\n",
    "print('\\nTipo de cambio de equilibrio (COP/CAD) por producto y ruta:')\n",
    "productos[['producto', 'codigo_hs', 'breakeven_mtl', 'breakeven_yvr']].round(2)"
   ]
  },
