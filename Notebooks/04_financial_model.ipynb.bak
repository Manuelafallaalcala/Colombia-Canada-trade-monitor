   "source": [
    "# Sub-paso 5 (Seccion 7.7.2): clasificacion de riesgo en semaforo.\n",
    "#\n",
    "# Logica de negocio: si incluso el nivel del VaR historico a 90 dias -el escenario con\n",
    "# respaldo estadistico real, no un supuesto arbitrario- ya deja el tipo de cambio por debajo\n",
    "# del breakeven de un producto, ese producto se clasifica en Rojo: en el 95% de los casos\n",
    "# historicos considerados por el VaR, la operacion ya perderia dinero. Si el VaR90 todavia\n",
    "# esta por encima del breakeven pero el escenario pesimista (mas extremo, sin respaldo\n",
    "# estadistico) si cae por debajo, es Amarillo: vulnerable solo bajo un supuesto mas severo\n",
    "# que el que sugiere la evidencia historica. Si ni siquiera el escenario pesimista alcanza el\n",
    "# breakeven, es Verde: el producto resiste ambas referencias de estres.\n",
    "\n",
    "def clasificar_riesgo(breakeven, copcad_var90=copcad_var90, copcad_pesimista=copcad_pesimista):\n",
    "    if copcad_var90 < breakeven:\n",
    "        return 'Rojo'\n",
    "    elif copcad_pesimista < breakeven:\n",
    "        return 'Amarillo'\n",
    "    else:\n",
    "        return 'Verde'\n",
    "\n",
    "productos['riesgo_mtl'] = productos['breakeven_mtl'].apply(clasificar_riesgo)\n",
    "productos['riesgo_yvr'] = productos['breakeven_yvr'].apply(clasificar_riesgo)\n",
    "\n",
    "print('Clasificacion de riesgo cambiario (semaforo), por producto y ruta:')\n",
    "productos[['producto', 'breakeven_mtl', 'riesgo_mtl', 'breakeven_yvr', 'riesgo_yvr']].round(2)"
   ]
  },
