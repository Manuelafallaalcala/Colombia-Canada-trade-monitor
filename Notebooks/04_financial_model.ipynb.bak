   "source": [
    "# ============================================================\n",
    "# Figura 4: Serie COP/CAD y volatilidad rodante (Seccion 8.1 de la guia)\n",
    "# ============================================================\n",
    "# Sub-paso 1 (Seccion 8.1.2): volatilidad rodante de 90 dias sobre la serie completa de\n",
    "# retorno_log ya calculada en la Etapa 4 (cop_cad_df). Se anualiza con la misma convencion\n",
    "# (raiz de 252 dias habiles) usada para volatilidad_anualizada, de forma que ambas curvas del\n",
    "# panel inferior queden en la misma unidad y sean directamente comparables.\n",
    "\n",
    "VENTANA_VOL_RODANTE = 90\n",
    "cop_cad_df['vol_rodante_90d'] = cop_cad_df['retorno_log'].rolling(VENTANA_VOL_RODANTE).std() * np.sqrt(252)\n",
    "\n",
    "print(f'Volatilidad rodante ({VENTANA_VOL_RODANTE} dias): calculada sobre '\n",
    "      f'{cop_cad_df[\"vol_rodante_90d\"].notna().sum()} de {len(cop_cad_df)} filas')\n",
    "print(f'Rango observado: {cop_cad_df[\"vol_rodante_90d\"].min():.2%} a {cop_cad_df[\"vol_rodante_90d\"].max():.2%}')\n",
    "print(f'Volatilidad anualizada de referencia (serie completa, Etapa 4): {volatilidad_anualizada:.2%}')\n"
   ]
  },
