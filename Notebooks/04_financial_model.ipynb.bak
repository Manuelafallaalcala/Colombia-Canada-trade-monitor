   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Verificacion 1 - costo_financiero_90d identico en los 3 escenarios, por producto+ruta: True (20 de 20 combinaciones)\n",
      "\n",
      "Verificacion 2 - margen_neto_30d > margen_neto_60d > margen_neto_90d, en las 60 filas: True\n",
      "\n",
      "Verificacion 3 - razon costo_financiero_60d/30d = 2.000 exacto: True\n",
      "Verificacion 3b - razon costo_financiero_90d/30d = 3.000 exacto: True\n",
      "\n",
      "Verificacion 4 - todas las columnas nuevas son valores finitos (sin NaN/inf): True\n",
      "\n",
      "Verificacion 5 - costo_financiero_90d como % de costo_total_cop, rango observado: 2.76% a 2.76% (OK, dentro de lo esperado)\n"
     ]
    }
   ],
   "source": [
    "# Verificaciones de calidad y de consistencia interna.\n",
    "\n",
    "# 1) Identidad: el costo financiero de un horizonte dado debe ser EXACTAMENTE el mismo para\n",
    "#    las 3 filas (escenarios) de un mismo producto y ruta -no depende del tipo de cambio,\n",
    "#    depende solo de costo_total_cop, que la Etapa 6 ya fijo como constante por producto-ruta.\n",
    "costo_fin_constante = tabla_capital.groupby(['producto', 'ruta'])['costo_financiero_90d'].nunique()\n",
    "print(f'Verificacion 1 - costo_financiero_90d identico en los 3 escenarios, por producto+ruta: '\n",
    "      f'{(costo_fin_constante == 1).all()} ({(costo_fin_constante == 1).sum()} de '\n",
    "      f'{len(costo_fin_constante)} combinaciones)')\n",
    "\n",
    "# 2) Monotonicidad (Sub-paso 6 de la guia): a mas dias de espera, mayor el costo financiero\n",
    "#    acumulado y por lo tanto MENOR el margen neto resultante -se verifica de forma directa\n",
    "#    fila por fila, no se asume.\n",
    "orden_correcto = bool((\n",
    "    (tabla_capital['margen_neto_30d'] > tabla_capital['margen_neto_60d']) &\n",
    "    (tabla_capital['margen_neto_60d'] > tabla_capital['margen_neto_90d'])\n",
    ").all())\n",
    "print(f'\\nVerificacion 2 - margen_neto_30d > margen_neto_60d > margen_neto_90d, en las '\n",
    "      f'{len(tabla_capital)} filas: {orden_correcto}')\n",
    "\n",
    "# 3) El costo financiero debe crecer de forma EXACTAMENTE proporcional a los dias (60 dias =\n",
    "#    2x el costo de 30 dias; 90 dias = 3x el costo de 30 dias), porque la formula es lineal en\n",
    "#    \"dias\" por construccion -otra identidad algebraica, no un patron aproximado.\n",
    "razon_60_30 = tabla_capital['costo_financiero_60d'] / tabla_capital['costo_financiero_30d']\n",
    "razon_90_30 = tabla_capital['costo_financiero_90d'] / tabla_capital['costo_financiero_30d']\n",
    "print(f'\\nVerificacion 3 - razon costo_financiero_60d/30d = 2.000 exacto: {np.allclose(razon_60_30, 2.0)}')\n",
    "print(f'Verificacion 3b - razon costo_financiero_90d/30d = 3.000 exacto: {np.allclose(razon_90_30, 3.0)}')\n",
    "\n",
    "# 4) Sin NaN/infinitos en ninguna columna nueva.\n",
    "columnas_nuevas = [c for c in tabla_capital.columns if 'financiero' in c or 'margen_neto' in c]\n",
    "sin_invalidos = tabla_capital[columnas_nuevas].apply(lambda c: np.isfinite(c)).all().all()\n",
    "print(f'\\nVerificacion 4 - todas las columnas nuevas son valores finitos (sin NaN/inf): {sin_invalidos}')\n",
    "\n",
    "# 5) Magnitud razonable: con un IBR de un digito y 90 dias, el costo de carry tipico deberia\n",
    "#    ser una fraccion pequena del costo total (una cifra por encima del 15% indicaria una tasa\n",
    "#    o un costo mal cargados en algun lado de la cadena).\n",
    "costo_fin_90d_pct_costo = tabla_capital['costo_financiero_90d'] / tabla_capital['costo_total_cop'] * 100\n",
    "fuera_de_rango = costo_fin_90d_pct_costo[costo_fin_90d_pct_costo > 15]\n",
    "print(f'\\nVerificacion 5 - costo_financiero_90d como % de costo_total_cop, rango observado: '\n",
    "      f'{costo_fin_90d_pct_costo.min():.2f}% a {costo_fin_90d_pct_costo.max():.2f}% '\n",
    "      f'{\"(OK, dentro de lo esperado)\" if len(fuera_de_rango) == 0 else \"-> ALERTA, revisar\"}')"
   ]
  },
