   ],
   "source": [
    "# Sub-paso 2 (Seccion 8.1.2): construccion de la figura de dos paneles. El sombreado de\n",
    "# episodios historicos y las leyendas manuales son un enriquecimiento sobre el codigo base de\n",
    "# la guia (que solo pide la linea de COP/CAD y la de volatilidad rodante).\n",
    "\n",
    "import os\n",
    "from matplotlib.patches import Patch\n",
    "\n",
    "os.makedirs('../outputs/figures', exist_ok=True)\n",
    "\n",
    "COLOR_TIPO_MOVIMIENTO = {'Devaluacion': '#F4B183', 'Apreciacion': '#9DC3E6'}\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(13, 8), sharex=True)\n",
    "\n",
    "linea_copcad, = ax1.plot(cop_cad_df['fecha'], cop_cad_df['COP_CAD'], color='#2E75B6', linewidth=1.2, label='COP/CAD')\n",
    "ax1.fill_between(cop_cad_df['fecha'], cop_cad_df['COP_CAD'], cop_cad_df['COP_CAD'].min(), alpha=0.15, color='#2E75B6')\n",
    "\n",
    "for _, ep in episodios_visibles.iterrows():\n",
    "    ax1.axvspan(ep['fecha_inicio_recortada'], ep['fecha_fin'],\n",
    "                color=COLOR_TIPO_MOVIMIENTO[ep['tipo_movimiento']], alpha=0.35, zorder=0)\n",
    "\n",
    "handles_episodios = [Patch(facecolor=color, alpha=0.35, label=f'Episodio: {tipo}')\n",
    "                      for tipo, color in COLOR_TIPO_MOVIMIENTO.items()\n",
    "                      if tipo in episodios_visibles['tipo_movimiento'].unique()]\n",
    "\n",
    "ax1.set_title('Tipo de cambio COP/CAD, 2020-2024 (episodios historicos de la Tarea 6 sombreados)', fontweight='bold')\n",
    "ax1.set_ylabel('COP por CAD')\n",
    "ax1.legend(handles=[linea_copcad] + handles_episodios, loc='upper left', fontsize=9)\n",
    "\n",
    "ax2.plot(cop_cad_df['fecha'], cop_cad_df['vol_rodante_90d'] * 100, color='#C55A11',\n",
    "         label=f'Volatilidad rodante {VENTANA_VOL_RODANTE}d (%)')\n",
    "ax2.axhline(y=volatilidad_anualizada * 100, color='red', linestyle='--',\n",
    "            label=f'Promedio periodo completo: {volatilidad_anualizada * 100:.1f}%')\n",
    "ax2.set_ylabel('Volatilidad anualizada (%)')\n",
