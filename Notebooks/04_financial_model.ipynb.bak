   "source": [
    "# Sub-paso 5 (Seccion 7.10.2): costo financiero y margen neto financiero para los tres\n",
    "# horizontes tipicos de cobro de una exportacion (30, 60 y 90 dias).\n",
    "#\n",
    "# Se aplica sobre las 60 filas de tabla_margenes (Etapa 6, las 3 escenarios), porque\n",
    "# costo_total_cop NO depende del escenario cambiario -es el mismo monto en pesos para las 3\n",
    "# filas de un mismo producto y ruta (verificado en la Etapa 6)-, asi que el costo financiero\n",
    "# tampoco deberia depender del escenario. Solo margen_neto_Xd SI varia por escenario, porque\n",
    "# margen_cop (el punto de partida) es distinto en cada uno. Se trabaja sobre una copia\n",
    "# (tabla_capital) para no mutar tabla_margenes, siguiendo el mismo criterio de las Etapas 8 y 9.\n",
    "\n",
    "tabla_capital = tabla_margenes.copy()\n",
    "\n",
    "for dias in [30, 60, 90]:\n",
    "    col_costo_fin = f'costo_financiero_{dias}d'\n",
    "    col_margen_fin = f'margen_neto_{dias}d'\n",
    "    col_margen_fin_pct = f'margen_neto_pct_{dias}d'\n",
    "\n",
    "    tabla_capital[col_costo_fin] = tabla_capital['costo_total_cop'] * ibr_diaria * dias\n",
    "    tabla_capital[col_margen_fin] = tabla_capital['margen_cop'] - tabla_capital[col_costo_fin]\n",
    "    tabla_capital[col_margen_fin_pct] = tabla_capital[col_margen_fin] / tabla_capital['ingreso_cop'] * 100\n",
    "\n",
    "print('Columnas nuevas calculadas para cada horizonte (30, 60, 90 dias): costo_financiero_Xd, '\n",
    "      'margen_neto_Xd (en COP) y margen_neto_pct_Xd (en % del ingreso, enriquecimiento sobre '\n",
    "      'el minimo de la guia, que solo pide la version en COP).')\n",
    "tabla_capital[['producto', 'ruta', 'escenario', 'margen_cop', 'margen_pct',\n",
    "               'costo_financiero_30d', 'margen_neto_30d', 'margen_neto_pct_30d']].head(6)"
   ]
  },
  {
   "cell_type": "code",
