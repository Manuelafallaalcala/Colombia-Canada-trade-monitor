   "source": [
    "# Cargar los episodios historicos (Tarea 6, Bloque A) y aplicar cada uno a los 10 productos x\n",
    "# 2 rutas, calculando en paralelo el margen SIN ajustar (formula identica a la Etapa 6) y el\n",
    "# margen AJUSTADO por cobertura natural (formula identica a la celda anterior de esta Etapa\n",
    "# 8), para poder comparar el efecto amortiguador bajo condiciones extremas reales.\n",
    "\n",
    "episodios = pd.read_excel('../dataraw/tabla_B6_episodios_historicos.xlsx')\n",
    "print(f'Episodios cargados: {len(episodios)}')\n",
    "print(episodios[['nombre_episodio', 'pct_cambio', 'tipo_movimiento']].to_string(index=False))\n",
    "\n",
    "filas_stress_hedge = []\n",
    "for _, ep in episodios.iterrows():\n",
    "    copcad_stress = copcad_base * (1 + ep['pct_cambio'] / 100)\n",
    "    for _, p in productos.iterrows():\n",
    "        fila_costos = costos.loc[costos['codigo_hs'] == p['codigo_hs']].iloc[0]\n",
    "        for ruta, col_costo in rutas.items():\n",
    "            ingreso = p['precio_cad'] * copcad_stress\n",
    "            costo_total_original = p['costo_produccion_cop'] + p[col_costo]\n",
    "            margen_pct_original = (ingreso - costo_total_original) / ingreso * 100\n",
    "\n",
    "            costo_importado_esc = p['costo_produccion_cop'] * fila_costos['pct_importado'] * (copcad_stress / copcad_base)\n",
    "            costo_nacional = p['costo_produccion_cop'] * fila_costos['pct_nacional']\n",
    "            costo_total_ajustado = costo_importado_esc + costo_nacional + p[col_costo]\n",
    "            margen_pct_ajustado = (ingreso - costo_total_ajustado) / ingreso * 100\n",
    "\n",
    "            filas_stress_hedge.append({\n",
    "                'episodio': ep['nombre_episodio'], 'producto': p['producto'], 'ruta': ruta,\n",
    "                'COPCAD_stress': copcad_stress, 'pct_importado': fila_costos['pct_importado'],\n",
    "                'margen_pct_original': margen_pct_original, 'margen_pct_ajustado': margen_pct_ajustado,\n",
    "            })\n",
    "\n",
    "stress_cobertura = pd.DataFrame(filas_stress_hedge)\n",
    "print(f'\\nFilas generadas: {len(stress_cobertura)} '\n",
    "      f'(esperado: {len(episodios)} episodios x 10 productos x 2 rutas = {len(episodios) * 20})')\n",
    "stress_cobertura.head(6)"
   ]
  },
