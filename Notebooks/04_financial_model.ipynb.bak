   "source": [
    "# Sub-paso 3 (Seccion 7.12.2): combinar con tabla_cob (Etapa 8) -la tabla que ya tiene\n",
    "# costo_importado_esc y margen_cop_ajustado-, no con tabla_margenes cruda de la Etapa 6. Se une\n",
    "# por codigo_hs, igual que en todas las etapas anteriores, y se valida la integridad del merge\n",
    "# antes de continuar (mismo patron defensivo usado en las Etapas 8, 9, 10 y 11).\n",
    "\n",
    "filas_antes = len(tabla_cob)\n",
    "\n",
    "tabla_drawback = tabla_cob.merge(\n",
    "    drawback[['codigo_hs', 'drawback_aplica', 'aplica_si', 'tipo_beneficio']],\n",
    "    on='codigo_hs', how='left', validate='m:1',\n",
    ")\n",
    "\n",
    "print(f'Filas antes del merge: {filas_antes} | Filas despues del merge: {len(tabla_drawback)}')\n",
    "assert len(tabla_drawback) == filas_antes, 'El merge cambio el numero de filas -revisar duplicados en codigo_hs'\n",
    "\n",
    "sin_match = tabla_drawback['aplica_si'].isna().sum()\n",
    "print(f'Filas sin match de informacion de Drawback (aplica_si nulo): {sin_match} (esperado 0)')\n",
    "assert sin_match == 0, 'Hay productos en tabla_cob sin fila correspondiente en tabla_B3'\n",
    "\n",
    "tabla_drawback[['producto', 'codigo_hs', 'escenario', 'costo_importado_esc', 'drawback_aplica', 'aplica_si']].head(6)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 67,
   "id": "2424a961",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-24T01:17:37.278181Z",
     "iopub.status.busy": "2026-07-24T01:17:37.277531Z",
     "iopub.status.idle": "2026-07-24T01:17:37.287791Z",
     "shell.execute_reply": "2026-07-24T01:17:37.285727Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Valores unicos de beneficio_drawback_cop donde NO aplica: [0.] (debe ser solo [0.])\n",
      "\n",
      "Beneficio promedio por combinacion (escenario Base, solo productos donde aplica): 1764.77 COP\n"
     ]
    }
   ],
   "source": [
    "# Sub-paso 4 (Seccion 7.12.2): beneficio de Drawback = 19% del costo importado ESCALADO por\n",
    "# escenario (costo_importado_esc, Etapa 8) -no del costo importado base congelado-, para los\n",
    "# productos donde aplica_si es True; cero para el resto. Se usa costo_importado_esc porque el\n",
    "# IVA que efectivamente se recupera es el que recae sobre el valor en pesos del insumo\n",
    "# importado EN CADA ESCENARIO cambiario, manteniendo la misma base de calculo que ya escala\n",
    "# con el tipo de cambio en el resto de la tabla.\n",
    "\n",
    "TASA_IVA_DRAWBACK = 0.19  # Art. 428 literal b) del Estatuto Tributario: tarifa general de IVA en Colombia\n",
    "\n",
    "tabla_drawback['beneficio_drawback_cop'] = np.where(\n",
    "    tabla_drawback['aplica_si'],\n",
    "    tabla_drawback['costo_importado_esc'] * TASA_IVA_DRAWBACK,\n",
    "    0.0,\n",
    ")\n",
    "\n",
    "# Sub-pasos 5 y 6 (Seccion 7.12.2): verificar que el beneficio es EXACTAMENTE cero donde no aplica.\n",
    "valores_no_aplica = tabla_drawback.loc[~tabla_drawback['aplica_si'], 'beneficio_drawback_cop'].unique()\n",
    "print(f'Valores unicos de beneficio_drawback_cop donde NO aplica: {valores_no_aplica} (debe ser solo [0.])')\n",
    "assert list(valores_no_aplica) == [0.0], 'El beneficio deberia ser exactamente 0 donde no aplica'\n",
    "\n",
    "promedio_base = tabla_drawback.loc[\n",
    "    (tabla_drawback['escenario'] == 'Base') & (tabla_drawback['aplica_si']), 'beneficio_drawback_cop'\n",
    "].mean()\n",
    "print(f'\\nBeneficio promedio por combinacion (escenario Base, solo productos donde aplica): {promedio_base:.2f} COP')\n"
   ]
  },
