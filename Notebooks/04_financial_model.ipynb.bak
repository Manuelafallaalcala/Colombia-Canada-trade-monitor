   "source": [
    "# Sub-paso 6 (Seccion 7.8.3): combinar tabla_margenes (Etapa 6, 60 filas) con la estructura\n",
    "# de costos recien cargada, y con costo_produccion_cop de la tabla productos.\n",
    "#\n",
    "# Se une por codigo_hs, no por el texto de 'producto': es la misma decision de diseno ya\n",
    "# documentada en la introduccion de la Etapa 6 (el nombre del producto no siempre coincide\n",
    "# exactamente entre archivos de distinto origen; el codigo HS de 10 digitos si es una llave\n",
    "# estable). Antes de dar el merge por bueno, se verifica de forma explicita que no se haya\n",
    "# perdido ni duplicado ninguna fila -un merge que silenciosamente descarta o duplica filas es\n",
    "# uno de los errores mas comunes y mas dificiles de detectar en un pipeline de datos.\n",
    "\n",
    "filas_antes = len(tabla_margenes)\n",
    "\n",
    "tabla_cob = tabla_margenes.merge(\n",
    "    costos[['codigo_hs', 'pct_importado', 'pct_nacional']], on='codigo_hs', how='left', validate='m:1'\n",
    ")\n",
    "tabla_cob = tabla_cob.merge(\n",
    "    productos[['codigo_hs', 'costo_produccion_cop']], on='codigo_hs', how='left', validate='m:1'\n",
    ")\n",
    "\n",
    "print(f'Filas antes del merge: {filas_antes} | Filas despues del merge: {len(tabla_cob)}')\n",
    "assert len(tabla_cob) == filas_antes, 'El merge cambio el numero de filas -revisar duplicados en codigo_hs'\n",
    "\n",
    "sin_match = tabla_cob['pct_importado'].isna().sum()\n",
    "print(f'Filas sin match de estructura de costos (pct_importado nulo): {sin_match} (esperado 0)')\n",
    "assert sin_match == 0, 'Hay productos en tabla_margenes sin fila correspondiente en tabla_B9'\n",
    "\n",
    "productos_en_ambas = set(tabla_margenes['codigo_hs']) == set(costos['codigo_hs'])\n",
    "print(f'Verificacion - los 10 codigo_hs de tabla_margenes coinciden exactamente con los 10 de tabla_B9: {productos_en_ambas}')\n",
    "\n",
    "tabla_cob[['producto', 'codigo_hs', 'escenario', 'pct_importado', 'pct_nacional', 'costo_produccion_cop']].head(6)"
   ]
  },
