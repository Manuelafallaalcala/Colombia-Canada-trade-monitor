   "source": [
    "# Sub-paso 1 (Seccion 7.10.2 de la guia): cargar la serie de tasas de interes (Tarea 8,\n",
    "# Bloque A). Igual que con tabla_B9 en la Etapa 8, este archivo se genero directamente con\n",
    "# pandas en este proyecto (sin el problema de codificacion que si tuvo tabla_B4), pero se\n",
    "# verifica la forma esperada en vez de asumirla a ciegas.\n",
    "\n",
    "ruta_tasas = '../dataraw/tabla_B8_tasas_interes.xlsx'\n",
    "tasas = pd.read_excel(ruta_tasas)\n",
    "\n",
    "columnas_esperadas = {'fecha', 'ibr_colombia_pct', 'tasa_bank_of_canada_pct'}\n",
    "columnas_faltantes = columnas_esperadas - set(tasas.columns)\n",
    "assert not columnas_faltantes, f'Faltan columnas esperadas en tabla_B8: {columnas_faltantes}'\n",
    "\n",
    "print(f'Registros cargados: {len(tasas)} (cobertura mensual, Tarea 8 del Bloque A)')\n",
    "print(f'Rango de fechas: {tasas[\"fecha\"].iloc[0]} a {tasas[\"fecha\"].iloc[-1]}')\n",
    "tasas.tail(5)"
   ]
  },
