      "\n",
      "Combinaciones (de 60) cuyo margen se agota antes de los 90 dias de plazo, solo por costo de capital: 7\n"
     ]
    }
   ],
   "source": [
    "# Funcionalidad adicional (no pedida de forma literal por la guia): en vez de limitarse a los\n",
    "# tres horizontes fijos de 30/60/90 dias, se calcula el numero MAXIMO de dias de plazo de\n",
    "# cobro que cada combinacion producto-ruta-escenario puede soportar antes de que el costo\n",
    "# financiero, por si solo, se coma la totalidad del margen bruto -el \"breakeven en el tiempo\",\n",
    "# analogo al breakeven cambiario de la Etapa 7 pero en la dimension de plazo de pago en vez de\n",
    "# tipo de cambio.\n",
    "#\n",
    "# Se despeja de margen_neto = 0: margen_cop = costo_total_cop x ibr_diaria x dias_breakeven\n",
    "#   dias_breakeven = margen_cop / (costo_total_cop x ibr_diaria)\n",
    "#\n",
    "# Caso especial: si margen_cop ya es <= 0 en un escenario (sin ningun costo financiero\n",
    "# todavia), la operacion ya es deficitaria por si sola -no tiene ningun \"plazo de gracia\"; el\n",
    "# breakeven en el tiempo se fija en 0 dias, no en un numero negativo sin sentido economico.\n",
    "\n",
    "tabla_capital['dias_breakeven_capital'] = np.where(\n",
    "    tabla_capital['margen_cop'] > 0,\n",
    "    tabla_capital['margen_cop'] / (tabla_capital['costo_total_cop'] * ibr_diaria),\n",
    "    0.0,\n",
    ")\n",
    "\n",
    "resumen_dias = tabla_capital.loc[\n",
    "    tabla_capital['escenario'] == 'Base', ['producto', 'ruta', 'margen_cop', 'dias_breakeven_capital']\n",
    "].sort_values('dias_breakeven_capital')\n",
    "print('Dias maximos de plazo de cobro antes de que el costo financiero elimine el margen '\n",
    "      '(escenario Base, de mas vulnerable a mas resiliente):')\n",
    "print(resumen_dias.round(1).to_string(index=False))\n",
    "\n",
    "# Verificacion de sentido: comparar contra los plazos tipicos de 30/60/90 dias -cuantas de las\n",
    "# 60 combinaciones NO alcanzarian siquiera a cubrir cada plazo, solo por costo de capital de\n",
    "# trabajo (sin contar todavia el riesgo cambiario, que se trata en otras etapas).\n",
    "for dias in [30, 60, 90]:\n",
    "    n_insuficiente = int((tabla_capital['dias_breakeven_capital'] < dias).sum())\n",
    "    print(f'\\nCombinaciones (de {len(tabla_capital)}) cuyo margen se agota antes de los {dias} '\n",
    "          f'dias de plazo, solo por costo de capital: {n_insuficiente}')"
   ]
  },
  {
   "cell_type": "code",
