   "source": [
    "# ============================================================\n",
    "# Figura 6: Mapa de riesgo por tipo de cambio de equilibrio (Seccion 8.3 de la guia)\n",
    "# ============================================================\n",
    "# Enriquecimiento sobre el codigo base de la guia: se anade una leyenda explicita del codigo\n",
    "# de colores de riesgo (Verde/Amarillo/Rojo) dentro de la propia figura -la guia colorea las\n",
    "# barras pero no las explica dentro de la imagen misma, dejando esa lectura solo al texto que\n",
    "# la acompana fuera del grafico.\n",
    "\n",
    "from matplotlib.patches import Patch\n",
    "\n",
    "COLORES_RIESGO = {'Verde': '#375623', 'Amarillo': '#BF8F00', 'Rojo': '#C00000'}\n",
    "\n",
    "breakevens = productos[['producto', 'breakeven_mtl', 'riesgo_mtl']].sort_values('breakeven_mtl')\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(11, 7))\n",
    "ax.barh(breakevens['producto'], breakevens['breakeven_mtl'],\n",
    "        color=[COLORES_RIESGO[r] for r in breakevens['riesgo_mtl']])\n",
    "\n",
    "linea_base = ax.axvline(x=copcad_base, color='blue', linestyle='--')\n",
    "linea_pesimista = ax.axvline(x=copcad_pesimista, color='orange', linestyle='--')\n",
    "linea_var90 = ax.axvline(x=copcad_var90, color='red', linestyle='--')\n",
    "\n",
    "ax.set_xlabel('Tipo de cambio COP/CAD de equilibrio (breakeven)')\n",
    "ax.set_title('Mapa de riesgo cambiario por producto (ruta Montreal)', fontweight='bold')\n",
    "\n",
    "niveles_presentes = [n for n in ['Verde', 'Amarillo', 'Rojo'] if n in breakevens['riesgo_mtl'].unique()]\n",
    "handles = [linea_base, linea_pesimista, linea_var90] + [Patch(facecolor=COLORES_RIESGO[n]) for n in niveles_presentes]\n",
    "labels = [\n",
    "    f'COP/CAD base ({copcad_base:,.0f})',\n",
    "    f'COP/CAD pesimista ({copcad_pesimista:,.0f})',\n",
    "    f'COP/CAD en VaR 90d ({copcad_var90:,.0f})',\n",
    "] + [f'Riesgo {n}' for n in niveles_presentes]\n",
    "ax.legend(handles, labels, loc='lower right', fontsize=9)\n",
    "\n",
    "plt.tight_layout()\n",
    "ruta_figura06 = '../outputs/figures/figura_06_mapa_riesgo_breakeven.png'\n",
    "plt.savefig(ruta_figura06, dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(f'Figura guardada en: {ruta_figura06}')\n",
    "print(f'Distribucion de riesgo (ruta Montreal, 10 productos): {breakevens[\"riesgo_mtl\"].value_counts().to_dict()}')\n"
   ]
  },
