   "source": [
    "# Sub-paso 3 y 4 (Seccion 7.8.2): convertir los porcentajes a formato decimal y verificar que\n",
    "# sumen exactamente 1.0 (100%) en cada fila. En el archivo tabla_B9 los porcentajes quedaron\n",
    "# guardados como numeros enteros (25, 75, etc.), no como fracciones (0.25, 0.75).\n",
    "\n",
    "costos['pct_importado'] = costos['pct_importado'] / 100\n",
    "costos['pct_nacional'] = costos['pct_nacional'] / 100\n",
    "\n",
    "costos['suma_check'] = costos['pct_importado'] + costos['pct_nacional']\n",
    "suma_ok = costos['suma_check'].between(0.999, 1.001).all()\n",
    "\n",
    "print('Verificacion - pct_importado + pct_nacional = 1.0 en las 10 filas:', suma_ok)\n",
    "if not suma_ok:\n",
    "    print(costos.loc[~costos['suma_check'].between(0.999, 1.001), ['producto', 'suma_check']])\n",
    "\n",
    "costos = costos.drop(columns='suma_check')\n",
    "costos[['producto', 'codigo_hs', 'pct_importado', 'pct_nacional']]"
   ]
  },
