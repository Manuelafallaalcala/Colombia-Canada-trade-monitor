   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import requests\n",
    "print('Librerias cargadas correctamente')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a3ca219c",
   "metadata": {},
   "source": [
    "Descarga usd/cad desde BANK OF CANADA"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "1261b61e",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-24T01:17:32.566258Z",
     "iopub.status.busy": "2026-07-24T01:17:32.565882Z",
     "iopub.status.idle": "2026-07-24T01:17:32.878533Z",
     "shell.execute_reply": "2026-07-24T01:17:32.877088Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Registros: 1246, promedio USD/CAD: 1.3232\n"
     ]
    }
   ],
   "source": [
    "def descargar_usdcad(start='2020-01-01', end='2024-12-31'):\n",
    "    url = ('https://www.bankofcanada.ca/valet/observations'\n",
    "           f'/FXUSDCAD/json?start_date={start}&end_date={end}')\n",
    "    respuesta = requests.get(url, timeout=30)\n",
    "    datos = respuesta.json()['observations']\n",
    "    filas = [{'fecha': o['d'], 'USDCAD': float(o['FXUSDCAD']['v'])} for o in datos]\n",
    "    df = pd.DataFrame(filas)\n",
    "    df['fecha'] = pd.to_datetime(df['fecha'])\n",
    "    return df.sort_values('fecha').reset_index(drop=True)\n",
    "boc_df = descargar_usdcad()\n",
    "print(f'Registros: {len(boc_df)}, promedio USD/CAD: {boc_df[\"USDCAD\"].mean():.4f}')"
   ]
  },
