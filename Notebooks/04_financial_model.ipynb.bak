   "source": [
    "# ============================================================\n",
    "# Figura 5: Margenes por escenario y ruta (Seccion 8.2 de la guia)\n",
    "# ============================================================\n",
    "# Se usa tabla_margenes (Etapa 6, margen bruto sin ajustar): esta figura representa la\n",
    "# sensibilidad \"cruda\" del margen al tipo de cambio, antes de cualquier ajuste posterior -es el\n",
    "# punto de partida que las Figuras 6 a 8 despues refinan o contextualizan.\n",
    "#\n",
    "# Enriquecimiento sobre el codigo base de la guia: sharey=True entre los dos paneles, para que\n",
    "# la comparacion visual entre rutas sea directa (con ejes Y independientes, una diferencia de\n",
    "# escala entre Montreal y Vancouver podria verse artificialmente parecida o distinta).\n",
    "\n",
    "COLORES_ESCENARIO = {'Optimista': '#375623', 'Base': '#2E75B6', 'Pesimista': '#C00000'}\n",
    "\n",
    "fig, ejes = plt.subplots(1, 2, figsize=(16, 7), sharey=True)\n",
    "\n",
    "for ax, ruta in zip(ejes, ['CTG-Montreal', 'CTG-Vancouver']):\n",
    "    datos_ruta = tabla_margenes[tabla_margenes['ruta'] == ruta]\n",
    "    pivote = datos_ruta.pivot_table(index='producto', columns='escenario', values='margen_pct')\n",
    "    pivote = pivote[['Optimista', 'Base', 'Pesimista']]\n",
    "    pivote.plot(kind='bar', ax=ax, color=[COLORES_ESCENARIO[c] for c in pivote.columns])\n",
    "    ax.axhline(y=0, color='black', linestyle='--', linewidth=1)\n",
    "    ax.set_title(ruta)\n",
    "    ax.set_ylabel('Margen (%)')\n",
    "    ax.set_xlabel('')\n",
    "    ax.tick_params(axis='x', rotation=75)\n",
    "    ax.legend(title='Escenario')\n",
    "\n",
    "plt.suptitle('Margenes por producto, escenario y ruta logistica', fontweight='bold', y=1.02)\n",
    "plt.tight_layout()\n",
    "ruta_figura05 = '../outputs/figures/figura_05_margenes_escenarios.png'\n",
    "plt.savefig(ruta_figura05, dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "productos_negativos = sorted(\n",
    "    tabla_margenes.loc[(tabla_margenes['escenario'] == 'Pesimista') & (tabla_margenes['margen_pct'] < 0), 'producto'].unique()\n",
    ")\n",
    "print(f'Figura guardada en: {ruta_figura05}')\n",
    "print(f'Productos con margen negativo en escenario Pesimista (alguna ruta): {productos_negativos}')\n"
   ]
  },
