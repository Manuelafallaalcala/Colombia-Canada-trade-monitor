   ],
   "source": [
    "# Sub-paso 3 (Seccion 7.7.2): nivel de COP/CAD correspondiente al peor escenario cubierto\n",
    "# por el VaR historico a 90 dias (Etapa 5). var_90d es un retorno logaritmico negativo\n",
    "# (una perdida en terminos de valor del CAD medido en pesos), asi que este calculo\n",
    "# representa una depreciacion del CAD respecto al nivel base.\n",
    "\n",
    "var_90d = var_escalado['VaR historico 90 dias (95%)']\n",
    "copcad_var90 = copcad_base * (1 + var_90d)\n",
    "\n",
    "print(f'COP/CAD base (Etapa 6):                          {copcad_base:,.2f}')\n",
    "print(f'VaR historico 90 dias (95%, Etapa 5):             {var_90d:.4%}')\n",
    "print(f'COP/CAD en el peor escenario del VaR 90d:         {copcad_var90:,.2f}')\n",
    "print(f'COP/CAD escenario pesimista arbitrario (Etapa 6): {copcad_pesimista:,.2f}')\n",
    "\n",
    "# Verificacion: el VaR historico esta respaldado por datos reales; el escenario pesimista\n",
    "# es un supuesto arbitrario de la Tarea 5 del Bloque A (-15%). No hay ninguna razon logica\n",
    "# para que uno sea siempre mas severo que el otro. En este dataset, de hecho, el escenario\n",
    "# pesimista (-15.00%) YA es mas severo que el peor caso cubierto por el VaR historico a 90\n",
    "# dias (-13.81%) -- exactamente lo que el stress testing de la Etapa 5 ya habia anticipado:\n",
    "# el peor escenario historico real supera al VaR escalado. Esta diferencia es justamente lo\n",
    "# que le da sentido a tener TRES niveles de riesgo (Verde/Amarillo/Rojo) en vez de un simple\n",
    "# SI/NO.\n",
    "mas_severo = 'el escenario pesimista' if copcad_pesimista < copcad_var90 else 'el VaR historico a 90 dias'\n",
    "print(f'\\nEscenario mas severo entre los dos (menor COP/CAD): {mas_severo}')"
   ]
  },
