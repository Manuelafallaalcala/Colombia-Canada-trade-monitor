      "VaR movil maximo (momento mas calmo): -1.0272%\n",
      "VaR movil mas reciente (ultimo dato disponible): -1.0272%\n"
     ]
    }
   ],
   "source": [
    "# 4) VaR movil (rolling VaR) - captura de riesgo cambiante en el tiempo\n",
    "#\n",
    "# El VaR calculado sobre toda la muestra (5 años) asume implicitamente que el riesgo\n",
    "# es constante en el tiempo. Ya vimos que NO lo es: la tabla de volatilidad por año\n",
    "# mostro que 2022 (17.88% anualizado) tuvo casi el doble de volatilidad que 2024\n",
    "# (11.82%). Un VaR \"de 5 años\" promedia estos regimenes y puede quedar desactualizado.\n",
    "#\n",
    "# El VaR movil recalcula el percentil 5 usando solo una ventana reciente de N dias\n",
    "# (aqui 252 dias ≈ 1 año habil), permitiendo que la metrica reaccione a cambios de\n",
    "# regimen de volatilidad. Es clave para gestion activa: limites de riesgo, decisiones\n",
    "# de cobertura (forwards/opciones) y alertas tempranas deben basarse en el riesgo\n",
    "# RECIENTE, no en un promedio historico que puede ya no reflejar las condiciones\n",
    "# actuales de mercado.\n",
    "\n",
    "ventana = 252  # ~1 año habil de mercado\n",
    "\n",
    "cop_cad_df['var_movil_95'] = cop_cad_df['retorno_log'].rolling(ventana).apply(\n",
    "    lambda x: np.percentile(x, 5), raw=True\n",
    ")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 5))\n",
    "ax.plot(cop_cad_df['fecha'], cop_cad_df['var_movil_95'], color='darkred',\n",
    "        label=f'VaR movil 95% (ventana {ventana}d)')\n",
    "ax.axhline(var_diario_95, color='black', linestyle='--',\n",
    "           label='VaR historico (muestra completa 2020-2024)')\n",
    "ax.set_title('VaR historico movil al 95% — COP/CAD')\n",
    "ax.set_ylabel('VaR diario')\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f'VaR movil minimo (peor momento de riesgo reciente): {cop_cad_df[\"var_movil_95\"].min():.4%}')\n",
    "print(f'VaR movil maximo (momento mas calmo): {cop_cad_df[\"var_movil_95\"].max():.4%}')\n",
    "print(f'VaR movil mas reciente (ultimo dato disponible): {cop_cad_df[\"var_movil_95\"].dropna().iloc[-1]:.4%}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "7d09e484",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-24T01:17:35.262712Z",
     "iopub.status.busy": "2026-07-24T01:17:35.262226Z",
     "iopub.status.idle": "2026-07-24T01:17:35.273147Z",
     "shell.execute_reply": "2026-07-24T01:17:35.271765Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Asimetria (skewness): 0.2122\n",
      "Curtosis en exceso: 1.6607  (una normal tiene curtosis en exceso = 0)\n",
      "Estadistico Jarque-Bera: 152.42\n",
      "p-value: 0.000000\n",
      "\n",
      "¿Los retornos son consistentes con una distribucion normal? False\n",
      "-> Se confirma el uso de VaR historico (no parametrico): los retornos del COP/CAD presentan colas pesadas y/o asimetria que un modelo normal subestimaria, especialmente relevante para el VaR al 99% y el Expected Shortfall.\n"
     ]
    }
   ],
   "source": [
    "# 5) Test de normalidad (Jarque-Bera) - justificacion formal del metodo historico\n",
    "#\n",
    "# El test de Jarque-Bera contrasta H0: \"los retornos siguen una distribucion normal\",\n",
    "# evaluando conjuntamente:\n",
    "#   - Asimetria (skewness): 0 en una normal; distinto de 0 indica que las perdidas y\n",
    "#     las ganancias no son igual de probables en magnitud.\n",
    "#   - Curtosis en exceso (kurtosis - 3): 0 en una normal; mayor a 0 indica \"colas\n",
    "#     pesadas\" (fat tails) — eventos extremos mas frecuentes que bajo una normal.\n",
    "#\n",
    "# Por que importa para elegir metodologia de VaR: si los retornos fueran normales,\n",
    "# un VaR parametrico (basado solo en media y desviacion estandar) seria valido y\n",
    "# mucho mas simple de calcular y de escalar (por ejemplo, el mismo factor sqrt(T)).\n",
    "# Si se rechaza la normalidad, el metodo historico (o Monte Carlo con una distribucion\n",
    "# de colas pesadas, ej. t-Student) es preferible, porque un VaR parametrico normal\n",
    "# subestimaria sistematicamente el riesgo de cola.\n",
    "#\n",
    "# JB = (n/6) * (S^2 + K^2/4), donde S = asimetria, K = curtosis en exceso.\n",
    "# Bajo H0, JB ~ chi2 con 2 grados de libertad. Para esa distribucion existe una forma\n",
    "# cerrada exacta: CDF_chi2_2(x) = 1 - exp(-x/2) (evita depender de scipy).\n",
    "\n",
    "n = len(retornos)\n",
    "asimetria = retornos.skew()          # pandas ya calcula skewness estandar\n",
    "curtosis_exceso = retornos.kurt()    # pandas ya reporta curtosis EN EXCESO (Fisher)\n",
    "\n",
    "jb_stat = (n / 6) * (asimetria**2 + (curtosis_exceso**2) / 4)\n",
    "jb_pvalue = math.exp(-jb_stat / 2)   # 1 - CDF chi2(df=2) = exp(-x/2)\n",
    "\n",
    "print(f'Asimetria (skewness): {asimetria:.4f}')\n",
    "print(f'Curtosis en exceso: {curtosis_exceso:.4f}  (una normal tiene curtosis en exceso = 0)')\n",
    "print(f'Estadistico Jarque-Bera: {jb_stat:.2f}')\n",
    "print(f'p-value: {jb_pvalue:.6f}')\n",
    "\n",
    "normal = jb_pvalue >= 0.05\n",
    "print(f'\\n¿Los retornos son consistentes con una distribucion normal? {normal}')\n",
    "if not normal:\n",
    "    print('-> Se confirma el uso de VaR historico (no parametrico): los retornos del '\n",
    "          'COP/CAD presentan colas pesadas y/o asimetria que un modelo normal '\n",
    "          'subestimaria, especialmente relevante para el VaR al 99% y el Expected Shortfall.')\n"
   ]
  },
