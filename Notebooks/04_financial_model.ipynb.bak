   "source": [
    "# Costo de produccion fijo por producto (Seccion 6.5.2 y 7.6.4 de la guia)\n",
    "#\n",
    "# Se calcula UNA SOLA VEZ, con el tipo de cambio BASE, y se mantiene fijo en los\n",
    "# tres escenarios (no se recalcula con el tipo de cambio de cada escenario). Si se\n",
    "# recalculara con cada escenario, el margen saldria identico en los tres casos y la\n",
    "# tabla no mostraria ninguna sensibilidad cambiaria real -es el error mas facil de\n",
    "# cometer en esta etapa, segun la advertencia explicita de la guia en la Seccion\n",
    "# 6.5.2, y por eso se deja como constante fija antes del bucle de escenarios.\n",
    "#\n",
    "# El factor 0.60 es el supuesto preliminar de la guia (Tarea 5, Bloque A): los\n",
    "# costos de produccion representan, en promedio, un 60% del precio de venta. Es un\n",
    "# placeholder explicito -la guia misma dice que debe ajustarse mas adelante con\n",
    "# datos mas especificos (tabla_B9_estructura_costos, Tarea 9 del Bloque A), que\n",
    "# todavia no existe en este proyecto. Cuando esa tabla este lista, este supuesto se\n",
    "# debe revisar antes de dar el modelo de margenes por definitivo.\n",
    "\n",
    "FACTOR_COSTO_PRODUCCION = 0.60  # placeholder, pendiente de tabla_B9 (Tarea 9, Bloque A)\n",
    "\n",
    "productos['costo_produccion_cop'] = productos['precio_cad'] * copcad_base * FACTOR_COSTO_PRODUCCION\n",
    "\n",
    "productos[['producto', 'precio_cad', 'costo_produccion_cop']]"
   ]
  },
