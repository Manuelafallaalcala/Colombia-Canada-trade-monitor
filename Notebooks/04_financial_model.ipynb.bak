    }
   ],
   "source": [
    "# Sub-paso 3 (Seccion 7.11.2): puntos forward y costo de cobertura, por paridad de tasas de\n",
    "# interes (Seccion 3.10 de la guia). Convencion actual/360 para los puntos forward -distinta\n",
    "# de la actual/365 usada para el IBR en la Etapa 10-, porque es el estandar de mercado para\n",
    "# cotizar puntos forward y depositos en eurodivisas; no es una inconsistencia entre etapas,\n",
    "# son dos convenciones de mercado distintas para dos instrumentos financieros distintos.\n",
    "#\n",
    "# Por que abs(): el costo de cubrirse es una magnitud (lo que cuesta fijar el tipo de cambio\n",
    "# hoy), independientemente de que el diferencial de tasas juegue a favor o en contra del\n",
    "# exportador -en este caso juega en contra (IBR Colombia > tasa Canada), pero la formula debe\n",
    "# funcionar igual si algun dia se invierte el diferencial.\n",
    "\n",
    "tabla_cobertura = tabla_margenes.copy()\n",
    "\n",
    "for dias in [30, 60, 90]:\n",
    "    puntos_forward_pct = (ibr_anual - tasa_canada_anual) * (dias / 360)\n",
    "    tabla_cobertura[f'puntos_forward_pct_{dias}d'] = puntos_forward_pct\n",
    "    tabla_cobertura[f'costo_cobertura_{dias}d'] = abs(puntos_forward_pct) * tabla_cobertura['ingreso_cop']\n",
    "\n",
    "print('Puntos forward (paridad de tasas de interes), por horizonte:')\n",
    "for dias in [30, 60, 90]:\n",
    "    pf = tabla_cobertura[f'puntos_forward_pct_{dias}d'].iloc[0]\n",
    "    print(f'  {dias} dias: {pf:.4%}')\n",
    "\n",
    "tabla_cobertura[['producto', 'ruta', 'escenario', 'ingreso_cop', 'costo_cobertura_30d',\n",
    "                  'costo_cobertura_60d', 'costo_cobertura_90d']].head(6)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 59,
   "id": "40ccd93e",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-24T01:17:37.038681Z",
