     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Verificacion 1 - identidad margen_final_cop = margen_cop_ajustado + beneficio_drawback_cop: True\n",
      "Verificacion 2 - beneficio_drawback_cop nunca es negativo: True\n",
      "Verificacion 3 - margen_final_cop == margen_cop_ajustado donde NO aplica el Drawback: True\n",
      "\n",
      "Verificacion 4 - margen_final_pct > margen_pct_ajustado donde aplica, por escenario: {'Base': True, 'Optimista': True, 'Pesimista': True}\n",
      "Verificacion 5 - todas las columnas nuevas son valores finitos (sin NaN/inf): True\n"
     ]
    }
   ],
   "source": [
    "# Verificaciones de calidad y de consistencia interna -mas alla del Sub-paso 9 literal de la\n",
    "# guia (que solo pide comprobar el escenario Pesimista), siguiendo el mismo estandar de rigor\n",
    "# aplicado en las Etapas 8, 9, 10 y 11: identidades algebraicas recalculadas de forma\n",
    "# independiente, casos limite y la propiedad economica que el modulo debe cumplir.\n",
    "\n",
    "# 1) Identidad algebraica exacta, recalculada por separado.\n",
    "recalculo = tabla_drawback['margen_cop_ajustado'] + tabla_drawback['beneficio_drawback_cop']\n",
    "identidad_ok = np.allclose(tabla_drawback['margen_final_cop'], recalculo)\n",
    "print(f'Verificacion 1 - identidad margen_final_cop = margen_cop_ajustado + beneficio_drawback_cop: {identidad_ok}')\n",
    "\n",
    "# 2) El beneficio nunca es negativo (19% de un costo, que siempre es positivo).\n",
    "sin_negativos = (tabla_drawback['beneficio_drawback_cop'] >= 0).all()\n",
    "print(f'Verificacion 2 - beneficio_drawback_cop nunca es negativo: {sin_negativos}')\n",
    "\n",
    "# 3) Donde NO aplica, margen_final debe ser IDENTICO al margen ajustado.\n",
    "no_aplica = ~tabla_drawback['aplica_si']\n",
    "sin_cambio = np.allclose(\n",
    "    tabla_drawback.loc[no_aplica, 'margen_final_cop'], tabla_drawback.loc[no_aplica, 'margen_cop_ajustado'])\n",
    "print(f'Verificacion 3 - margen_final_cop == margen_cop_ajustado donde NO aplica el Drawback: {sin_cambio}')\n",
    "\n",
    "# 4) Sub-paso 9 de la guia, extendido a los 3 escenarios (no solo Pesimista): donde SI aplica,\n",
    "#    margen_final_pct debe ser ESTRICTAMENTE mayor que margen_pct_ajustado en TODOS los\n",
    "#    escenarios, porque costo_importado_esc es siempre positivo para los 8 productos con\n",
    "#    pct_importado > 0 (verificado contra tabla_B9 en la Etapa 8).\n",
    "mejora_por_escenario = {}\n",
    "for esc in ['Base', 'Optimista', 'Pesimista']:\n",
    "    filtro = (tabla_drawback['escenario'] == esc) & tabla_drawback['aplica_si']\n",
    "    mejora_por_escenario[esc] = bool((\n",
    "        tabla_drawback.loc[filtro, 'margen_final_pct'] > tabla_drawback.loc[filtro, 'margen_pct_ajustado']\n",
    "    ).all())\n",
    "print(f'\\nVerificacion 4 - margen_final_pct > margen_pct_ajustado donde aplica, por escenario: {mejora_por_escenario}')\n",
    "\n",
    "# 5) Sin NaN ni infinitos en ninguna columna nueva.\n",
    "columnas_nuevas = ['beneficio_drawback_cop', 'margen_final_cop', 'margen_final_pct']\n",
    "sin_invalidos = tabla_drawback[columnas_nuevas].apply(lambda c: np.isfinite(c)).all().all()\n",
    "print(f'Verificacion 5 - todas las columnas nuevas son valores finitos (sin NaN/inf): {sin_invalidos}')\n"
   ]
  },
