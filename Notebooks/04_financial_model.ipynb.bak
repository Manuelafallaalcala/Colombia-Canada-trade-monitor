   "source": [
    "# Tres escenarios de tipo de cambio COP/CAD (Seccion 3.5 y 7.6.3 de la guia)\n",
    "#\n",
    "# Base: promedio movil de 90 dias del COP/CAD historico (cop_cad_df, construido en\n",
    "# la Etapa 3), tomando el ultimo valor disponible de esa ventana.\n",
    "# Optimista: base x 1.10 (+10%). Pesimista: base x 0.85 (-15%).\n",
    "\n",
    "cop_cad_df['COPCAD_base_roll'] = cop_cad_df['COP_CAD'].rolling(window=90).mean()\n",
    "copcad_base = cop_cad_df['COPCAD_base_roll'].dropna().iloc[-1]\n",
    "copcad_optimista = copcad_base * 1.10\n",
    "copcad_pesimista = copcad_base * 0.85\n",
    "\n",
    "print(f'COP/CAD base (promedio movil 90 dias, al {cop_cad_df[\"fecha\"].iloc[-1].date()}): {copcad_base:.2f}')\n",
    "print(f'COP/CAD optimista (+10%): {copcad_optimista:.2f}')\n",
    "print(f'COP/CAD pesimista (-15%): {copcad_pesimista:.2f}')\n",
    "\n",
    "# Verificacion: optimista > base > pesimista\n",
    "print(f'\\nVerificacion - orden optimista > base > pesimista: '\n",
    "      f'{copcad_optimista > copcad_base > copcad_pesimista}')"
   ]
  },
