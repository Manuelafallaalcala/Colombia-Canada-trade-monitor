     ]
    }
   ],
   "source": [
    "# Verificaciones de calidad sobre el costo logistico estimado\n",
    "\n",
    "# 1) Magnitud razonable: el flete maritimo tipico para carga general de larga\n",
    "#    distancia suele estar entre 0.02 y 0.30 USD/kg. Fuera de ese rango conviene\n",
    "#    revisar el supuesto de capacidad de carga o la tarifa cargada.\n",
    "tarifa_usd_kg = tarifa_usd_por_ruta / CAPACIDAD_CARGA_KG\n",
    "fuera_de_rango = tarifa_usd_kg[(tarifa_usd_kg < 0.02) | (tarifa_usd_kg > 0.30)]\n",
    "print('Tarifa de flete en USD/kg, por ruta:')\n",
    "print(tarifa_usd_kg.round(4))\n",
    "if len(fuera_de_rango) > 0:\n",
    "    print(f'\\nALERTA - tarifa fuera del rango tipico de flete maritimo (0.02-0.30 USD/kg): '\n",
    "          f'{fuera_de_rango.round(4).to_dict()}')\n",
    "else:\n",
    "    print('\\nVerificacion 1 - tarifas en USD/kg dentro del rango tipico de flete maritimo: OK')\n",
    "\n",
    "# 2) Nota de calidad de dato: para CTG-Vancouver, la cotizacion de 20 pies (Hapag-\n",
    "#    Lloyd, 5.281 USD) es MAS CARA que la de 40 pies (4.610 USD) en el archivo\n",
    "#    fuente, lo cual es atipico (lo normal es que el contenedor mas grande cueste\n",
    "#    mas en terminos absolutos). Puede deberse a desbalance de esa ruta para ese\n",
    "#    tamano especifico, o a que Vancouver solo tiene una cotizacion por tamano (a\n",
    "#    diferencia de Montreal, que tiene 3 y se pueden promediar). Se usa la cifra tal\n",
    "#    como esta reportada, con su URL de evidencia en el archivo fuente, pero es un\n",
    "#    punto a revisar si se consigue una cotizacion adicional de Vancouver 20 pies.\n",
    "print('\\nNota - Vancouver 20 pies (5.281 USD) cuesta mas que Vancouver 40 pies (4.610 USD) '\n",
    "      'en el archivo fuente: revisar si aparece una segunda cotizacion de 20 pies mas '\n",
    "      'adelante, porque hoy depende de una sola naviera sin punto de comparacion.')"
   ]
  },
