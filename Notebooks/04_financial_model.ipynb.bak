     "text": [
      "\n",
      "\n",
      "--- Ruta Vancouver ---\n",
      "riesgo_yvr\n",
      "Verde    9\n",
      "Rojo     1\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "# Verificaciones de calidad y de consistencia interna. Un modulo de riesgo no se acepta solo\n",
    "# porque \"corrio sin errores\": tiene que cuadrar logicamente con los modulos anteriores del\n",
    "# mismo notebook (Etapa 5 y Etapa 6). Las verificaciones 3 y 4 no las pide la guia de forma\n",
    "# literal, pero son el tipo de chequeo cruzado que se exige antes de dar por bueno un modulo\n",
    "# de riesgo en un entorno profesional.\n",
    "\n",
    "# 1) Cota de seguridad amplia, solo para atrapar errores gruesos de calculo (una division\n",
    "#    invertida, una columna mal unida, un factor de escala equivocado). NO se usa el rango\n",
    "#    orientativo de la guia (2.000-4.500) como umbral de error: ese rango describe valores\n",
    "#    TIPICOS de mercado del COP/CAD, no limites validos para un breakeven -y un breakeven por\n",
    "#    debajo de ese rango no es un error, es la señal de que el margen del producto es tan\n",
    "#    sano que ni el peor COP/CAD historico observado (ver Nota 1b) lo habria hecho perder\n",
    "#    dinero. Se usa entonces una cota amplia (100 a 20.000) que si detectaria un error real de\n",
    "#    varios ordenes de magnitud.\n",
    "cota_min, cota_max = 100, 20000\n",
    "fuera_de_cota = productos[\n",
    "    (productos['breakeven_mtl'] < cota_min) | (productos['breakeven_mtl'] > cota_max) |\n",
    "    (productos['breakeven_yvr'] < cota_min) | (productos['breakeven_yvr'] > cota_max)\n",
    "]\n",
    "print(f'Verificacion 1 - breakeven dentro de la cota de seguridad ({cota_min}-{cota_max}), '\n",
    "      f'pensada para descartar errores gruesos de calculo: '\n",
    "      f'{\"OK\" if len(fuera_de_cota)==0 else \"ALERTA \" + str(len(fuera_de_cota)) + \" fuera de cota\"}')\n",
    "\n",
    "# 1b) Nota informativa (no es una alerta de error): comparar el breakeven contra el rango\n",
    "#    HISTORICO REAL observado en cop_cad_df (Etapa 3), no contra el rango orientativo de la\n",
    "#    guia. Un breakeven por debajo del minimo historico observado significa que, bajo los\n",
    "#    costos actuales, ese producto NUNCA habria perdido dinero en ningun dia de la serie\n",
    "#    2020-2024, ni siquiera en el peor momento real de devaluacion del CAD -es la lectura mas\n",
    "#    favorable posible del indicador, no un problema de datos.\n",
    "cop_cad_hist_min, cop_cad_hist_max = cop_cad_df['COP_CAD'].min(), cop_cad_df['COP_CAD'].max()\n",
    "print(f'\\nNota informativa - rango historico REAL del COP/CAD (2020-2024, Etapa 3): '\n",
    "      f'{cop_cad_hist_min:.2f} a {cop_cad_hist_max:.2f}')\n",
    "nunca_hubiera_perdido = productos[\n",
    "    (productos['breakeven_mtl'] < cop_cad_hist_min) & (productos['riesgo_mtl'] != 'Rojo')\n",
    "]['producto'].tolist()\n",
    "print(f'Productos cuyo breakeven en MTL esta por debajo del minimo COP/CAD jamas observado '\n",
    "      f'(nunca habrian perdido dinero en 2020-2024, ni en el peor dia real): '\n",
    "      f'{nunca_hubiera_perdido}')\n",
    "\n",
    "# 2) Sin valores nulos, infinitos, cero o negativos (un breakeven invalido indicaria\n",
    "#    precio_cad <= 0, un problema de datos aguas arriba en tabla_B4).\n",
    "valores_invalidos = productos[['breakeven_mtl', 'breakeven_yvr']].apply(\n",
    "    lambda col: (~np.isfinite(col)) | (col <= 0)\n",
    ").any(axis=1)\n",
    "print(f'\\nVerificacion 2 - todos los breakeven son valores finitos y positivos: {(~valores_invalidos).all()}')\n",
    "\n",
    "# 3) Consistencia cruzada con la Etapa 6: un producto con margen_pct positivo en el\n",
    "#    escenario Base (tabla_margenes) DEBE tener breakeven < copcad_base para esa misma\n",
    "#    ruta, y viceversa -son la misma condicion economica expresada de dos formas distintas.\n",
    "chequeo = tabla_margenes.loc[tabla_margenes['escenario'] == 'Base', ['producto', 'ruta', 'margen_pct']].copy()\n",
    "mapa_ruta_col = {'CTG-Montreal': 'breakeven_mtl', 'CTG-Vancouver': 'breakeven_yvr'}\n",
    "chequeo['breakeven'] = chequeo.apply(\n",
    "    lambda r: productos.loc[productos['producto'] == r['producto'], mapa_ruta_col[r['ruta']]].iloc[0], axis=1\n",
    ")\n",
    "chequeo['consistente'] = np.where(\n",
    "    chequeo['margen_pct'] > 0, chequeo['breakeven'] < copcad_base, chequeo['breakeven'] >= copcad_base\n",
    ")\n",
    "print(f'\\nVerificacion 3 - consistencia breakeven vs margen_pct Base (Etapa 6): '\n",
    "      f'{chequeo[\"consistente\"].sum()} de {len(chequeo)} combinaciones producto-ruta '\n",
    "      f'{\"(OK)\" if chequeo[\"consistente\"].all() else \"-> ALERTA, revisar filas inconsistentes:\"}')\n",
    "if not chequeo['consistente'].all():\n",
    "    print(chequeo[~chequeo['consistente']].to_string(index=False))\n",
    "\n",
    "# 4) La ruta a Vancouver tiene mayor costo logistico que Montreal para los 10 productos\n",
    "#    (verificado en la Etapa 6); por lo tanto el breakeven en YVR debe ser siempre mayor o\n",
    "#    igual que en MTL, producto por producto, sin excepcion.\n",
    "yvr_mayor = (productos['breakeven_yvr'] >= productos['breakeven_mtl']).all()\n",
    "print(f'\\nVerificacion 4 - breakeven_yvr >= breakeven_mtl en los 10 productos: {yvr_mayor}')\n",
    "\n",
    "# 5) El caso del carbon bituminoso ya quedo documentado en el cierre de la Etapa 6 como el\n",
    "#    unico producto con margen negativo en el escenario Base. Por construccion (Verificacion\n",
    "#    3), debe ser tambien el unico clasificado en Rojo en ambas rutas. Si aparece cualquier\n",
    "#    otro producto en Rojo, o si el carbon NO aparece, hay que revisar la logica antes de\n",
    "#    continuar -no es un detalle cosmetico, es la misma alerta que ya se documento arriba.\n",
    "rojos = sorted(set(productos.loc[productos['riesgo_mtl'] == 'Rojo', 'producto']) |\n",
    "               set(productos.loc[productos['riesgo_yvr'] == 'Rojo', 'producto']))\n",
    "print(f'\\nVerificacion 5 - producto(s) en Rojo en al menos una ruta: {rojos}')\n",
    "print('(se espera unicamente \"Carbon bituminoso\", el mismo caso ya documentado en el cierre de la Etapa 6)')\n",
    "\n",
    "print('\\nDistribucion del semaforo de riesgo, por ruta:')\n",
    "for ruta_nombre, col in [('Montreal', 'riesgo_mtl'), ('Vancouver', 'riesgo_yvr')]:\n",
    "    print(f'\\n--- Ruta {ruta_nombre} ---')\n",
    "    print(productos[col].value_counts())"
   ]
  },
