   "source": [
    "# Guardar el resultado oficial de la Etapa 10 (Sub-paso 7 de la guia, Seccion 7.10.3).\n",
    "\n",
    "columnas_finales = (\n",
    "    ['producto', 'codigo_hs', 'ruta', 'escenario', 'COPCAD', 'ingreso_cop', 'costo_total_cop',\n",
    "     'margen_cop', 'margen_pct']\n",
    "    + [f'{pref}_{d}d' for d in [30, 60, 90] for pref in ['costo_financiero', 'margen_neto', 'margen_neto_pct']]\n",
    "    + ['dias_breakeven_capital', 'costo_financiero_90d_ibr_max', 'margen_neto_90d_ibr_max']\n",
    ")\n",
    "tabla_costo_capital = tabla_capital[columnas_finales].copy()\n",
    "\n",
    "ruta_tabla09 = '../outputs/tables/tabla_09_costo_capital.xlsx'\n",
    "tabla_costo_capital.to_excel(ruta_tabla09, index=False, sheet_name='costo_capital')\n",
    "\n",
    "print(f'Archivo guardado en: {ruta_tabla09}')\n",
    "print(f'Filas: {len(tabla_costo_capital)} (esperado 60, igual que tabla_margenes de la Etapa 6)')\n",
    "tabla_costo_capital.round(2).head(6)"
   ]
