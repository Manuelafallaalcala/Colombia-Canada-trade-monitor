    "    'margen_cop', 'margen_pct', 'pct_importado', 'pct_nacional', 'costo_total_ajustado',\n",
    "    'margen_cop_ajustado', 'margen_pct_ajustado', 'drawback_aplica', 'beneficio_drawback_cop',\n",
    "    'margen_final_cop', 'margen_final_pct',\n",
    "]].copy()\n",
    "\n",
    "ruta_tabla11 = '../outputs/tables/tabla_11_margen_final_ajustado.xlsx'\n",
    "tabla_11_final.to_excel(ruta_tabla11, index=False, sheet_name='margen_final')\n",
    "\n",
    "print(f'Archivo guardado en: {ruta_tabla11}')\n",
    "print(f'Filas: {len(tabla_11_final)} (esperado 60, igual que tabla_margenes de la Etapa 6)')\n",
    "print('\\nModelo financiero completo. Archivo final guardado correctamente.')\n",
    "tabla_11_final.round(2).head(6)\n"
