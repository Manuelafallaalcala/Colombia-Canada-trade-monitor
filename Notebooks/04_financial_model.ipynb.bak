    "import os\n",
    "\n",
    "# Tabla_04: indicadores de riesgo cambiario (entregable oficial de la Etapa 5)\n",
    "#\n",
    "# Formato exacto pedido por la guia (Seccion 7.5.2): 5 indicadores -- volatilidad\n",
    "# anualizada y los cuatro VaR historicos (1, 30, 60 y 90 dias al 95%).\n",
    "\n",
    "indicadores = pd.DataFrame({\n",
    "    'indicador': ['Volatilidad anualizada', 'VaR diario (95%)', 'VaR 30 dias (95%)',\n",
    "                   'VaR 60 dias (95%)', 'VaR 90 dias (95%)'],\n",
    "    'valor_%': [\n",
    "        volatilidad_anualizada * 100,\n",
    "        var_diario_95 * 100,\n",
    "        var_escalado['VaR historico 30 dias (95%)'] * 100,\n",
    "        var_escalado['VaR historico 60 dias (95%)'] * 100,\n",
    "        var_escalado['VaR historico 90 dias (95%)'] * 100,\n",
    "    ],\n",
    "    'interpretacion': [\n",
    "        'Variabilidad esperada del COP/CAD en un ano tipico',\n",
    "        'Perdida maxima esperada en 1 dia, con 95% de confianza',\n",
    "        'Perdida maxima esperada en 30 dias, con 95% de confianza',\n",
    "        'Perdida maxima esperada en 60 dias, con 95% de confianza',\n",
    "        'Perdida maxima esperada en 90 dias, con 95% de confianza']\n",
    "})\n",
    "\n",
    "# Se guarda en outputs/tables/ para alinear la estructura de carpetas con la que pide\n",
    "# la guia (MIC-CC/outputs/tables/), separando las tablas de resultados del archivo\n",
    "# fx_cop_usd_cad.xlsx que quedo en outputs/ (Etapa 3).\n",
    "os.makedirs('../outputs/tables', exist_ok=True)\n",
    "ruta_tabla04 = '../outputs/tables/tabla_04_indicadores_riesgo.xlsx'\n",
