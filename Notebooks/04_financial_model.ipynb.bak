   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Episodios cargados: 4 (esperado entre 4 y 6, Seccion 6.6.5 de la guia)\n",
      "                                nombre_episodio tipo_movimiento  pct_cambio  COPCAD_implicado\n",
      "                 Apreciacion del peso 2022-2024     Apreciacion      -25.64           2301.88\n",
      "                       Choque pandemia COVID-19     Devaluacion       27.66           3951.82\n",
      "Alza de tasas Fed e incertidumbre politica 2022     Devaluacion       36.53           4226.40\n",
      "                     Crisis petrolera 2014-2016     Devaluacion       80.81           5597.13\n",
      "\n",
      "Nota de interpretacion (importante para leer el resto de esta etapa):\n",
      "COPCAD_implicado > copcad_base -> el CAD vale MAS pesos -> FAVORABLE para el margen del exportador.\n",
      "COPCAD_implicado < copcad_base -> el CAD vale MENOS pesos -> ADVERSO para el margen del exportador.\n",
      "En este modelo, una devaluacion del peso (pct_cambio positivo) es FAVORABLE para el exportador, no adversa;\n",
      "el unico episodio adverso de los documentados es la apreciacion del peso 2022-2024 (pct_cambio negativo).\n"
     ]
    }
   ],
   "source": [
    "# Sub-paso 1 y 2 (Seccion 7.9.2 de la guia): cargar los episodios historicos (Tarea 6, Bloque\n",
    "# A) y verificar que la columna de porcentaje de cambio existe con valores numericos.\n",
    "#\n",
    "# Se recarga el archivo aqui mismo (en vez de reutilizar el 'episodios' que ya quedo en\n",
    "# memoria como insumo del diagnostico de la Etapa 8) para que esta etapa sea autocontenida y\n",
    "# se pueda ejecutar de forma independiente si alguna vez se reordena o se re-ejecuta solo este\n",
    "# tramo del notebook. El contenido es el mismo archivo, asi que los valores deben coincidir.\n",
    "\n",
    "episodios = pd.read_excel('../dataraw/tabla_B6_episodios_historicos.xlsx')\n",
    "\n",
    "columnas_esperadas = {'nombre_episodio', 'pct_cambio', 'tipo_movimiento'}\n",
    "columnas_faltantes = columnas_esperadas - set(episodios.columns)\n",
    "assert not columnas_faltantes, f'Faltan columnas esperadas en tabla_B6: {columnas_faltantes}'\n",
    "assert pd.api.types.is_numeric_dtype(episodios['pct_cambio']), 'pct_cambio debe ser numerico'\n",
    "assert 4 <= len(episodios) <= 6, 'la guia exige entre 4 y 6 episodios documentados (Seccion 6.6.5)'\n",
    "\n",
    "# Se muestra ordenado por pct_cambio, y se calcula de una vez el COPCAD que le corresponderia\n",
    "# a cada episodio -asi el signo y la magnitud de cada uno quedan visibles ANTES de construir\n",
    "# la grilla completa de 80 filas, en vez de descubrirlos indirectamente despues.\n",
    "episodios = episodios.sort_values('pct_cambio').reset_index(drop=True)\n",
    "episodios['COPCAD_implicado'] = copcad_base * (1 + episodios['pct_cambio'] / 100)\n",
    "\n",
    "print(f'Episodios cargados: {len(episodios)} (esperado entre 4 y 6, Seccion 6.6.5 de la guia)')\n",
    "print(episodios[['nombre_episodio', 'tipo_movimiento', 'pct_cambio', 'COPCAD_implicado']].round(2).to_string(index=False))\n",
    "\n",
    "print('\\nNota de interpretacion (importante para leer el resto de esta etapa):')\n",
    "print('COPCAD_implicado > copcad_base -> el CAD vale MAS pesos -> FAVORABLE para el margen del exportador.')\n",
    "print('COPCAD_implicado < copcad_base -> el CAD vale MENOS pesos -> ADVERSO para el margen del exportador.')\n",
    "print('En este modelo, una devaluacion del peso (pct_cambio positivo) es FAVORABLE para el exportador, no adversa;')\n",
    "print('el unico episodio adverso de los documentados es la apreciacion del peso 2022-2024 (pct_cambio negativo).')"
   ]
  },
