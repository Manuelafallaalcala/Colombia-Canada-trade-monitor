   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Recomendacion oficial (basada en VaR), conteo por horizonte -Sub-paso 5 de la guia:\n",
      "\n",
      "--- Horizonte 30 dias ---\n",
      "recomendacion_var_30d\n",
      "Cubrirse    60\n",
      "Name: count, dtype: int64\n",
      "\n",
      "--- Horizonte 60 dias ---\n",
      "recomendacion_var_60d\n",
      "Cubrirse    60\n",
      "Name: count, dtype: int64\n",
      "\n",
      "--- Horizonte 90 dias ---\n",
      "recomendacion_var_90d\n",
      "Cubrirse    60\n",
      "Name: count, dtype: int64\n",
      "\n",
      "Verificacion - combinaciones que recomiendan Cubrirse, por horizonte: {30: 60, 60: 60, 90: 60}\n",
      "Verificacion - la cantidad de Cubrirse no disminuye al crecer el horizonte: True\n"
     ]
    }
   ],
   "source": [
    "# Sub-paso 3 (continuacion) y Sub-pasos 5-6 (Seccion 7.11.2-7.11.3): perdida potencial segun\n",
    "# el VaR de cada horizonte, y recomendacion oficial -la version que pide la guia de forma\n",
    "# literal, usando unicamente el VaR historico al 95%.\n",
    "\n",
    "for dias in [30, 60, 90]:\n",
    "    tabla_cobertura[f'perdida_var_{dias}d'] = abs(var_dict[dias]) * tabla_cobertura['ingreso_cop']\n",
    "    tabla_cobertura[f'recomendacion_var_{dias}d'] = np.where(\n",
    "        tabla_cobertura[f'costo_cobertura_{dias}d'] < tabla_cobertura[f'perdida_var_{dias}d'],\n",
    "        'Cubrirse', 'No cubrirse',\n",
    "    )\n",
    "\n",
    "print('Recomendacion oficial (basada en VaR), conteo por horizonte -Sub-paso 5 de la guia:')\n",
    "for dias in [30, 60, 90]:\n",
    "    print(f'\\n--- Horizonte {dias} dias ---')\n",
    "    print(tabla_cobertura[f'recomendacion_var_{dias}d'].value_counts())\n",
    "\n",
    "# Verificacion (Sub-paso 6 de la guia, adaptada a este dataset): se espera que la cantidad de\n",
    "# combinaciones que recomiendan Cubrirse NO disminuya al crecer el horizonte, porque la\n",
    "# perdida potencial segun el VaR crece con la raiz del tiempo (mas rapido, en terminos\n",
    "# relativos, que el costo del forward, que crece de forma lineal con el plazo).\n",
    "n_cubrirse = {dias: int((tabla_cobertura[f'recomendacion_var_{dias}d'] == 'Cubrirse').sum()) for dias in [30, 60, 90]}\n",
    "print(f'\\nVerificacion - combinaciones que recomiendan Cubrirse, por horizonte: {n_cubrirse}')\n",
    "print(f'Verificacion - la cantidad de Cubrirse no disminuye al crecer el horizonte: '\n",
    "      f'{n_cubrirse[30] <= n_cubrirse[60] <= n_cubrirse[90]}')"
   ]
  },
  {
   "cell_type": "code",
