   ],
   "source": [
    "# Sub-paso 5 (Seccion 7.9.3): identificar las combinaciones con el margen mas negativo.\n",
    "peores_10 = tabla_stress.sort_values('margen_pct').head(10)\n",
    "print('Las 10 combinaciones producto-ruta-episodio con el margen mas negativo:')\n",
    "print(peores_10[['episodio', 'producto', 'ruta', 'pct_cambio', 'COPCAD_stress', 'margen_pct']].round(2).to_string(index=False))\n",
    "\n",
    "# Sub-paso 6 (Seccion 7.9.3) -- CON UNA CORRECCION IMPORTANTE respecto a la redaccion literal\n",
    "# de la guia. La guia dice textualmente que hay que revisar que los margenes mas negativos\n",
    "# correspondan \"al episodio historico con mayor porcentaje de devaluacion\". Esa frase asume,\n",
    "# implicitamente, que una devaluacion del peso es la direccion ADVERSA para el exportador. En\n",
    "# ESTE modelo eso es al reves -no es una interpretacion libre, se desprende directamente de la\n",
    "# Seccion 3.5 de la propia guia y de como se construyo la Etapa 6 de este notebook (escenario\n",
    "# Optimista = COPCAD mas alto = peso MAS devaluado = MEJOR margen; escenario Pesimista =\n",
    "# COPCAD mas bajo = peso MAS apreciado = PEOR margen). Una devaluacion del peso ES BUENA para\n",
    "# un exportador que cobra en moneda extranjera y tiene sus costos en pesos.\n",
    "#\n",
    "# Por eso la verificacion correcta no es \"mayor devaluacion\", sino \"menor COPCAD_stress\" -que\n",
    "# en los episodios documentados corresponde al unico episodio de apreciacion. Se verifica esto\n",
    "# de forma explicita antes de aceptarlo, en vez de asumir la redaccion literal de la guia.\n",
    "episodio_mas_adverso_esperado = episodios.loc[episodios['COPCAD_implicado'].idxmin(), 'nombre_episodio']\n",
    "episodio_en_peores = peores_10['episodio'].mode().iloc[0]\n",
    "\n",
    "print(f'\\nEpisodio con el COPCAD_stress mas bajo (el realmente adverso para el margen del '\n",
    "      f'exportador, segun la Seccion 3.5 de la guia): \"{episodio_mas_adverso_esperado}\"')\n",
    "print(f'Episodio mas frecuente entre las 10 peores combinaciones: \"{episodio_en_peores}\"')\n",
    "print(f'Verificacion - coinciden: {episodio_mas_adverso_esperado == episodio_en_peores}')"
   ]
  },
