   "source": [
    "# Sub-paso 7 (Seccion 7.12.2): margen final = margen ya ajustado por cobertura natural\n",
    "# (Etapa 8) + beneficio de Drawback. Es, por diseno, el numero mas completo de todo el modelo.\n",
    "\n",
    "tabla_drawback['margen_final_cop'] = tabla_drawback['margen_cop_ajustado'] + tabla_drawback['beneficio_drawback_cop']\n",
    "tabla_drawback['margen_final_pct'] = tabla_drawback['margen_final_cop'] / tabla_drawback['ingreso_cop'] * 100\n",
    "\n",
    "print('Columnas nuevas calculadas: beneficio_drawback_cop, margen_final_cop, margen_final_pct')\n",
    "tabla_drawback[['producto', 'ruta', 'escenario', 'margen_pct', 'margen_pct_ajustado', 'margen_final_pct']].head(6)\n"
   ]
  },
