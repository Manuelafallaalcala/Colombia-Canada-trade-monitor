   ],
   "source": [
    "# Cargar y convertir costos_logisticos_rutas.xlsx a un costo en COP por kilogramo\n",
    "#\n",
    "# Este archivo NO tiene la forma que la guia asume (costo en COP ya calculado por\n",
    "# producto y ruta). Es una tabla de cotizaciones de flete maritimo por CONTENEDOR\n",
    "# completo (20 o 40 pies), por naviera, para las 4 combinaciones ruta+sentido\n",
    "# posibles. Convertirlo a un costo por kilogramo -la misma unidad que precio_cad,\n",
    "# porque todos los productos de tabla_B4 estan cotizados 'Kilogramo (FOB)'- requiere\n",
    "# decisiones que la guia no cubre. Se documentan explicitamente:\n",
    "#\n",
    "# 1) Solo interesa el sentido de EXPORTACION (Cartagena -> destino). Las filas en\n",
    "#    sentido contrario ('Montreal CA - Cartagena CO', 'Vancouver CA - Cartagena CO')\n",
    "#    son fletes de importacion hacia Colombia y no aplican a este modelo.\n",
    "# 2) Se usa el contenedor de 20 pies, no el de 40. El MIC-CC esta dirigido a PYMEs\n",
    "#    exportadoras (Seccion 2.1 de la guia), que tipicamente embarcan volumenes\n",
    "#    menores; el de 20 pies es el supuesto mas realista para ese perfil.\n",
    "# 3) Cuando hay varias cotizaciones para la misma ruta (distintas navieras), se\n",
    "#    promedian.\n",
    "# 4) Se asume una capacidad de carga util de 20.000 kg por contenedor de 20 pies.\n",
    "#    Es una aproximacion estandar de la industria para carga general; el archivo NO\n",
    "#    reporta peso de carga, solo tarifa por contenedor, asi que este numero es un\n",
    "#    supuesto explicito y ajustable, no un dato de la fuente.\n",
    "# 5) La tarifa esta en USD; se convierte a COP con la TRM mas reciente disponible en\n",
    "#    la propia serie del modelo (cop_cad_df), para no introducir una tasa de cambio\n",
    "#    nueva y mantener todo el notebook apoyado en una sola fuente de tipo de cambio.\n",
    "\n",
    "fletes = pd.read_excel('../dataraw/costos_logisticos_rutas.xlsx')\n",
    "\n",
    "# La tarifa viene como texto con formato colombiano: \"$ 1.018,00\" (punto = miles,\n",
    "# coma = decimales). Se limpia y convierte a float.\n",
    "def limpiar_tarifa(valor):\n",
    "    texto = str(valor).replace('$', '').replace(' ', '').replace('.', '').replace(',', '.')\n",
    "    return float(texto)\n",
    "\n",
    "fletes['tarifa_usd'] = fletes['tarifa_usd_teu'].apply(limpiar_tarifa)\n",
    "\n",
    "RUTAS_EXPORTACION = {\n",
    "    'Cartagena CO - Montreal CA': 'CTG-Montreal',\n",
    "    'Cartagena CO - Vancouver CA': 'CTG-Vancouver',\n",
    "}\n",
    "CONTENEDOR = '20 pies'\n",
    "CAPACIDAD_CARGA_KG = 20000  # supuesto documentado arriba, ajustable si se consigue un dato mas preciso\n",
    "\n",
    "fletes_export = fletes[\n",
    "    fletes['ruta'].isin(RUTAS_EXPORTACION) & (fletes['tipo_contenedor'] == CONTENEDOR)\n",
    "].copy()\n",
    "fletes_export['ruta_modelo'] = fletes_export['ruta'].map(RUTAS_EXPORTACION)\n",
    "\n",
    "tarifa_usd_por_ruta = fletes_export.groupby('ruta_modelo')['tarifa_usd'].mean()\n",
    "\n",
    "trm_reciente = cop_cad_df['TRM_COP_USD'].iloc[-1]\n",
    "fecha_trm_reciente = cop_cad_df['fecha'].iloc[-1]\n",
    "\n",
    "costo_logistico_cop_kg = (tarifa_usd_por_ruta / CAPACIDAD_CARGA_KG) * trm_reciente\n",
    "\n",
    "print(f'Cotizaciones de flete usadas (contenedor {CONTENEDOR}, sentido exportacion):')\n",
    "print(fletes_export[['ruta_modelo', 'naviera', 'tarifa_usd']].to_string(index=False))\n",
    "print(f'\\nTRM usada para la conversion (mas reciente en cop_cad_df, {fecha_trm_reciente.date()}): {trm_reciente:.2f}')\n",
    "print(f'\\nCosto logistico estimado (COP por kg):')\n",
    "print(costo_logistico_cop_kg.round(2))"
   ]
  },
